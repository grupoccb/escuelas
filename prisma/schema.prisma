// Esquema de la base: Fase 1 (bloque 1.1).
//
// Reglas (CLAUDE.md):
// - Toda tabla lleva organizacion_id (invariante 1). La tabla organizacion es la raíz: su id
//   ES el organizacion_id.
// - Toda tabla lleva eliminado_en; nunca DELETE físico (invariante 3).
// - Integridad entre organizaciones en la base: toda referencia entre tablas es una llave
//   foránea COMPUESTA (x_id, organizacion_id) → tabla(id, organizacion_id). Por eso cada tabla
//   declara @@unique([id, organizacion_id]). Una fila no puede apuntar a otra organización.
//   Las relaciones opcionales usan onDelete/onUpdate Restrict: SetNull anularía también
//   organizacion_id, que es obligatoria.
// - Los índices únicos parciales (WHERE eliminado_en IS NULL, teléfono normalizado) y los CHECK
//   no se pueden expresar aquí: viven como SQL al final de la migración.
// - Nombres de tablas y columnas en snake_case, igual que en el modelo de datos.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ── Configuración ──────────────────────────────────────────────────────────────────────

model organizacion {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre         String
  /// Identificador corto y estable para iniciar sesión (minúsculas, dígitos y guiones). Único entre
  /// las organizaciones vivas (índice parcial en la migración). Nulo solo en organizaciones de prueba.
  slug           String?
  creado_en      DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en   DateTime? @db.Timestamptz(6)

  verticales                 vertical[]
  sucursales                 sucursal[]
  sucursal_verticales        sucursal_vertical[]
  canales_whatsapp           canal_whatsapp[]
  bandejas_chatwoot          bandeja_chatwoot[]
  campanas                   campana[]
  etapas_pipeline            etapa_pipeline[]
  leads                      lead[]
  prospectos                 prospecto[]
  conversaciones             conversacion[]
  mensajes                   mensaje[]
  interacciones              interaccion[]
  consentimientos            consentimiento[]
  plantillas_mensaje         plantilla_mensaje[]
  automatizaciones           automatizacion[]
  ejecuciones                automatizacion_ejecucion[]
  tareas_asesor              tarea_asesor[]
  eventos_inesperados evento_inesperado[]
  eventos_entrega_pendientes evento_entrega_pendiente[]
  configuraciones            configuracion_organizacion[]
  textos_bot                 texto_bot[]
  eventos_twilio             evento_twilio[]
  programas                  programa[]
  grupos                     grupo[]
  grupo_horarios             grupo_horario[]
  usuarios                   usuario[]
  usuarios_sucursales        usuario_sucursal[]
  sesiones                   sesion[]
  intentos_acceso            intento_acceso[]
  instructores               instructor[]
  registros_cambio           registro_cambio[]
  fichas_salud               ficha_salud[]
  accesos_dato_sensible      acceso_dato_sensible[]
  salones                    salon[]
  instructores_sucursales    instructor_sucursal[]
  precios                    precio[]
  promociones                promocion[]
  promociones_verticales     promocion_vertical[]
  promociones_sucursales     promocion_sucursal[]
  promociones_programas      promocion_programa[]
  promociones_beneficios     promocion_beneficio[]
  promociones_aplicaciones   promocion_aplicacion[]
  cotizaciones               cotizacion[]
  lista_espera               lista_espera[]
  clases_muestra             clase_muestra[]
  conversaciones_instructor  conversacion_instructor[]
  avisos_maestro             aviso_maestro[]
  registros_clase_muestra    registro_clase_muestra[]
  registros_tutor            registro_tutor[]
  documentos_legales         documento_legal[]
  aceptaciones_legales       aceptacion_legal[]
  motivos_perdida            motivo_perdida[]
  historial_etapas           lead_etapa_historial[]
  transiciones_etapa         transicion_etapa[]
  avisos_promocion           aviso_promocion[]
  codigos_rastreo            codigo_rastreo[]
  tutores                    tutor[]
  alumnos                    alumno[]
  tutores_alumnos            tutor_alumno[]
  inscripciones              inscripcion[]
  motivos_baja               motivo_baja[]
  inscripciones_movimientos  inscripcion_movimiento[]
  asistencias                asistencia[]
  niveles_progresion         nivel_progresion[]
  progresiones               alumno_progresion[]
  eventos                    evento[]
  eventos_alumno             evento_alumno[]
  cargos                     cargo[]
  pagos                      pago[]
  pagos_aplicaciones         pago_aplicacion[]
  productos                  producto[]
  ventas                     venta[]
  gastos_campana             gasto_campana[]
}

/// Ajustes de la organización: UNA fila viva por organización (índice único parcial en la migración).
/// Se lee SIEMPRE con leerConfiguracion() (src/configuracion/), que pone los valores por defecto
/// cuando no hay fila. Para agregar un ajuste: columna tipada con default aquí + migración, campo
/// y default en src/configuracion/ y una línea en el lector. Los bloques siguientes la extienden
/// (modo de cierre de inscripción, sucursal alterna, etc.).
enum politica_sucursal_sin_programa {
  ofrecer_otra
  avisar_asesor
}

/// Quién cierra la inscripción (decisión 7 del plan, F6). `asesor_whatsapp` (por omisión): el maestro marca «listo para cerrar» y el asesor
/// convierte y cobra por WhatsApp. `maestro_en_sitio`: el maestro, con permiso, convierte al lead al terminar la clase muestra (el cobro sigue
/// siendo registro manual, H2).
enum modo_cierre_inscripcion {
  asesor_whatsapp
  maestro_en_sitio
}

model configuracion_organizacion {
  id                        String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id           String                         @db.Uuid
  /// Tope de mensajes automáticos por teléfono en una ventana móvil de 24 h (contexto, sección 11).
  max_automaticos_por_dia   Int                            @default(3)
  /// Tope de mensajes de marketing por teléfono dentro de la ventana de abajo.
  max_marketing_por_ventana Int                            @default(1)
  /// Días de la ventana del tope de marketing.
  ventana_marketing_dias    Int                            @default(7)
  /// Qué hace el bot cuando la sucursal elegida no tiene programa para la edad (C7, decisión 8): ofrecer la(s) otra(s)
  /// sucursal(es) que sí lo tienen, o pasar directo al asesor.
  sucursal_sin_programa     politica_sucursal_sin_programa @default(ofrecer_otra)
  /// Cuántos días vale una cotización (a lo más; antes vence si lo que cotizó vence: una promoción o el precio).
  cotizacion_vigencia_dias  Int                            @default(7)
  /// Cuántas horas tiene una familia para tomar el lugar que se le ofreció de la lista de espera antes de que el asesor
  /// decida si pasa al siguiente (C9).
  lista_espera_oferta_horas Int                            @default(48)
  /// Con cuánta anticipación mínima (minutos) se puede agendar una clase muestra: la clase debe empezar al menos
  /// este tiempo después de ahora (D1).
  clase_muestra_anticipacion_min Int                       @default(120)
  /// Hasta cuántos días hacia adelante se puede agendar una clase muestra (D1).
  clase_muestra_horizonte_dias   Int                       @default(60)
  /// Cuántas horas después de marcar asistió / no asistió se puede corregir el error (D4).
  clase_muestra_correccion_horas Int                       @default(48)
  /// Quién cierra la inscripción (F6): ver `modo_cierre_inscripcion`.
  modo_cierre               modo_cierre_inscripcion        @default(asesor_whatsapp)
  /// Cuántas faltas consecutivas (sesiones con pase tomado) disparan la tarea para el asesor (G2). Entre 1 y 30 (CHECK).
  umbral_faltas_consecutivas Int                           @default(3)
  /// Días de atraso con los que una familia con deuda vencida genera su tarea para el asesor (H6). Entre 1 y 365 (CHECK).
  umbral_dias_deuda         Int                            @default(15)
  /// Módulos por organización (V1). La captación es el módulo base y NO tiene columna: nunca se apaga. Sin fila de configuración, todos encendidos.
  /// Las dependencias entre módulos (inscripción necesita el cotizador; finanzas y operación necesitan inscripción; tableros necesita inscripción, finanzas y clase muestra) las impone un CHECK.
  modulo_cotizador          Boolean                        @default(true)
  modulo_clase_muestra      Boolean                        @default(true)
  modulo_inscripcion        Boolean                        @default(true)
  modulo_operacion          Boolean                        @default(true)
  modulo_finanzas           Boolean                        @default(true)
  modulo_tableros           Boolean                        @default(true)
  /// V5: horario de envío de lo que inicia el sistema, en minutos desde la medianoche (hora local de la sucursal). La escuela puede ESTRECHARlo, nunca salir de 09:00–20:00 (540–1200; CHECK, invariante 14).
  horario_envio_inicio_min  Int                            @default(540)
  horario_envio_fin_min     Int                            @default(1200)
  /// V5: minutos de silencio del contacto antes de avisar a los asesores que dejó la captura a medias. De 5 a 1440 (CHECK).
  lead_a_medias_minutos     Int                            @default(30)
  /// V5: respuestas que el bot no entiende antes de pasar la conversación a una persona. De 1 a 10 (CHECK).
  bot_max_intentos          Int                            @default(3)
  /// V5: ocupación (%) desde la que un grupo es «a reventar» y hasta la que es «vacío» en el tablero ejecutivo (CHECK: vacío < a reventar).
  ocupacion_a_reventar_pct  Int                            @default(90)
  ocupacion_vacio_pct       Int                            @default(25)
  creado_en                 DateTime                       @default(now()) @db.Timestamptz(6)
  actualizado_en            DateTime                       @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en              DateTime?                      @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
}

model vertical {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id           String    @db.Uuid
  nombre                    String
  slug                      String
  /// Cómo se llama el avance del alumno en esta vertical (los textos viven aquí, no en código: invariante 2).
  /// Nulo si la vertical no usa progresión.
  etiqueta_progresion       String?
  /// Cómo se llama el evento de la vertical.
  etiqueta_evento           String?
  /// ¿Esta vertical lleva progresión (niveles, grados)? La usa G3.
  usa_progresion            Boolean   @default(false)
  /// Color de marca `#RRGGBB` para la interfaz y la landing; nulo = el de la organización.
  color_marca               String?
  logo_url                  String?
  /// ¿El bot de WhatsApp cotiza en esta vertical? Encendido: después de las tres preguntas usa el catálogo (programa,
  /// otra sucursal, horarios, precio y promoción, lista de espera) en vez de pasar directo al asesor. Apagado
  /// (por omisión): la captura de tres preguntas y el pase al asesor no cambian (decisión 15 del plan).
  cotizador_whatsapp_activo Boolean   @default(false)
  /// ¿El bot de WhatsApp agenda la clase muestra después de que el contacto elige horario (D1)? Solo tiene efecto con
  /// `cotizador_whatsapp_activo` encendido. Apagado (por omisión): el bot cierra como antes.
  clase_muestra_whatsapp_activo Boolean @default(false)
  activo                    Boolean   @default(true)
  creado_en                 DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en              DateTime? @db.Timestamptz(6)

  organizacion        organizacion         @relation(fields: [organizacion_id], references: [id])
  sucursal_verticales sucursal_vertical[]
  canales_whatsapp    canal_whatsapp[]
  campanas            campana[]
  leads               lead[]
  prospectos          prospecto[]
  plantillas_mensaje  plantilla_mensaje[]
  automatizaciones    automatizacion[]
  programas           programa[]
  promociones         promocion_vertical[]
  documentos_legales  documento_legal[]
  codigos_rastreo     codigo_rastreo[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  niveles_progresion  nivel_progresion[]
  eventos             evento[]
  productos producto[]
}

model sucursal {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String    @db.Uuid
  nombre          String
  direccion       String?
  /// Zona horaria IANA. Define el horario de envío de esa sucursal (invariante 14).
  zona_horaria    String
  activo          Boolean   @default(true)
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime? @db.Timestamptz(6)

  organizacion        organizacion          @relation(fields: [organizacion_id], references: [id])
  sucursal_verticales sucursal_vertical[]
  canales_whatsapp    canal_whatsapp[]
  campanas            campana[]
  leads               lead[]
  automatizaciones    automatizacion[]
  programas           programa[]
  usuarioSucursals    usuario_sucursal[]
  salones             salon[]
  instructores        instructor_sucursal[]
  promociones         promocion_sucursal[]
  cotizaciones        cotizacion[]
  codigos_rastreo     codigo_rastreo[]
  tutores             tutor[]
  alumnos             alumno[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  eventos       evento[]
  cargos        cargo[]
  ventas        venta[]
}

/// Qué verticales se imparten en qué sucursal.
model sucursal_vertical {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String    @db.Uuid
  sucursal_id     String    @db.Uuid
  vertical_id     String    @db.Uuid
  activo          Boolean   @default(true)
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime? @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  sucursal     sucursal     @relation(fields: [sucursal_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  vertical     vertical     @relation(fields: [vertical_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
}

enum calidad_meta {
  alta
  media
  baja
  desconocida
}

/// Un número de WhatsApp receptor. Resuelve el mensaje entrante a su vertical (y, si aplica, a
/// una sucursal). Los campos de Twilio/Meta quedan vacíos mientras no haya cuenta real.
model canal_whatsapp {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id       String       @db.Uuid
  vertical_id           String       @db.Uuid
  /// Nulo = el canal atiende todas las sucursales de la vertical.
  sucursal_id           String?      @db.Uuid
  /// Formato de Twilio: "whatsapp:+521…". Nulo en canales sin número (la bandeja API de la demo).
  numero_whatsapp       String?
  messaging_service_sid String?
  sender_sid            String?
  waba_id               String?
  nombre_publico        String
  calidad_meta          calidad_meta @default(desconocida)
  activo                Boolean      @default(true)
  creado_en             DateTime     @default(now()) @db.Timestamptz(6)
  actualizado_en        DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en          DateTime?    @db.Timestamptz(6)

  organizacion      organizacion       @relation(fields: [organizacion_id], references: [id])
  vertical          vertical           @relation(fields: [vertical_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  sucursal          sucursal?          @relation(fields: [sucursal_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  bandejas_chatwoot bandeja_chatwoot[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
}

/// La bandeja de Chatwoot de un canal. Con ella el backend sabe de qué organización y canal es
/// cada evento del Agent Bot. Los ids de Chatwoot se llenan al aprovisionar.
model bandeja_chatwoot {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id     String    @db.Uuid
  canal_whatsapp_id   String    @db.Uuid
  nombre              String
  chatwoot_account_id Int?
  chatwoot_inbox_id   Int?
  creado_en           DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en        DateTime? @db.Timestamptz(6)

  organizacion   organizacion   @relation(fields: [organizacion_id], references: [id])
  canal_whatsapp canal_whatsapp @relation(fields: [canal_whatsapp_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  conversaciones conversacion[]
  conversaciones_instructor conversacion_instructor[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
}

// ── CRM ────────────────────────────────────────────────────────────────────────────────

enum origen_campana {
  facebook
  instagram
  tiktok
  google
  referido
  presencial
  otro
}

model campana {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String         @db.Uuid
  nombre          String
  origen          origen_campana
  vertical_id     String?        @db.Uuid
  sucursal_id     String?        @db.Uuid
  /// Id del anuncio en Meta (ReferralSourceId). Con él la atribución de un lead encuentra su campaña.
  anuncio_id      String?
  presupuesto     Decimal?       @db.Decimal(12, 2)
  fecha_inicio    DateTime?      @db.Date
  fecha_fin       DateTime?      @db.Date
  activo          Boolean        @default(true)
  creado_en       DateTime       @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime?      @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  vertical     vertical?    @relation(fields: [vertical_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  sucursal     sucursal?    @relation(fields: [sucursal_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  leads        lead[]
  codigos_rastreo codigo_rastreo[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  gastos          gasto_campana[]
}

/// Qué papel juega una etapa en la lógica del sistema (D1). El código NUNCA busca etapas por nombre: los nombres son de la
/// escuela y cambian; busca por este tipo. Una etapa sin tipo es solo una etapa de la escuela.
enum tipo_sistema_etapa {
  nuevo
  contactado
  muestra_agendada
  muestra_asistida
  negociacion
  inscrito
  perdido
}

/// Etapas del embudo, configurables. Los nombres viven aquí, no en código.
model etapa_pipeline {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id            String    @db.Uuid
  nombre                     String
  orden                      Int
  es_ganado                  Boolean   @default(false)
  es_perdido                 Boolean   @default(false)
  dias_alerta_sin_movimiento Int?
  /// Papel de la etapa para el sistema (nulo = etapa propia de la escuela). A lo más una viva por tipo y organización.
  tipo_sistema               tipo_sistema_etapa?
  creado_en                  DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en               DateTime? @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  leads        lead[]
  historial_anterior lead_etapa_historial[] @relation("historial_etapa_anterior")
  historial_nueva    lead_etapa_historial[] @relation("historial_etapa_nueva")
  transiciones_desde transicion_etapa[]     @relation("transicion_desde")
  transiciones_hacia transicion_etapa[]     @relation("transicion_hacia")

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
}

/// El adulto que escribe (invariante 13). Sus hijos o alumnos potenciales son `prospecto`.
model lead {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id       String    @db.Uuid
  vertical_interes_id   String    @db.Uuid
  sucursal_interes_id   String?   @db.Uuid
  campana_id            String?   @db.Uuid
  etapa_id              String    @db.Uuid
  /// E.164, siempre de normalizarTelefono() (invariante 7). Nulo si el contacto no trae teléfono.
  telefono              String?
  nombre_contacto       String?
  /// Atribución Click-to-WhatsApp, tal como la entrega la fuente de atribución.
  ctwa_clid             String?
  anuncio_id            String?
  anuncio_titulo        String?
  /// El referral completo, sin perder campos que hoy no se usan.
  atribucion            Json?
  ultima_interaccion_en DateTime? @db.Timestamptz(6)
  /// Por qué se perdió (D7). Nulo si no está perdido; al recuperarlo se limpia (el historial conserva el motivo).
  motivo_perdida_id     String?   @db.Uuid
  /// Cuántas veces se recuperó después de darse por perdido (D7).
  recuperaciones        Int       @default(0)
  /// El tutor en que se convirtió el adulto que escribió. Nulo hasta la conversión (F2).
  tutor_id              String?   @db.Uuid
  creado_en             DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en          DateTime? @db.Timestamptz(6)

  organizacion     organizacion   @relation(fields: [organizacion_id], references: [id])
  tutor            tutor?         @relation(fields: [tutor_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  motivo_perdida   motivo_perdida? @relation(fields: [motivo_perdida_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  historial_etapas lead_etapa_historial[]
  avisos_promocion aviso_promocion[]
  codigos_rastreo  codigo_rastreo[]
  vertical_interes vertical       @relation(fields: [vertical_interes_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  sucursal_interes sucursal?      @relation(fields: [sucursal_interes_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  campana          campana?       @relation(fields: [campana_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  etapa            etapa_pipeline @relation(fields: [etapa_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  prospectos       prospecto[]
  conversaciones   conversacion[]
  interacciones    interaccion[]
  tareas_asesor    tarea_asesor[]
  eventos_inesperados evento_inesperado[]
  cotizaciones     cotizacion[]
  lista_espera     lista_espera[]
  clases_muestra   clase_muestra[]
  registros_clase_muestra registro_clase_muestra[]
  aceptaciones_legales aceptacion_legal[]
  inscripciones inscripcion[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([etapa_id, ultima_interaccion_en])
}

enum origen_prospecto {
  bot
  asesor
  /// Un prospecto ADICIONAL que llegó por el cuestionario de la landing (el primero es `bot`: el bot de WhatsApp sigue sin repetirlo).
  landing
}

/// Cada niño o alumno potencial de un lead. El bot captura uno; el asesor agrega los demás.
model prospecto {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id      String           @db.Uuid
  lead_id              String           @db.Uuid
  vertical_interes_id  String           @db.Uuid
  nombre               String?
  /// Lo que dice el adulto ("como 6"). Si el asesor captura la fecha de nacimiento, es la edad cumplida ese día (V3).
  edad_declarada       Int?
  /// V3: lo que el asesor captura al agregar otro niño. Los apellidos y la fecha de nacimiento son lo que la conversión usaría de todos modos (cero recaptura);
  /// la fecha del acta que captura el maestro en su registro (D5) manda sobre esta.
  apellidos            String?          @db.VarChar(120)
  fecha_nacimiento     DateTime?        @db.Date
  /// V3: con la clave, reintentar el alta del mismo niño no lo duplica (índice único parcial en la migración).
  clave_idempotencia   String?          @db.VarChar(120)
  /// El programa que le corresponde o que eligió en el bot cuando hay varios para su edad (C6). Es una sugerencia,
  /// no una inscripción.
  programa_sugerido_id String?          @db.Uuid
  /// El alumno en que se convirtió este prospecto. Nulo hasta la conversión (F2); a lo más uno vivo por alumno.
  alumno_id            String?          @db.Uuid
  origen               origen_prospecto @default(bot)
  creado_en            DateTime         @default(now()) @db.Timestamptz(6)
  actualizado_en       DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en         DateTime?        @db.Timestamptz(6)

  organizacion      organizacion   @relation(fields: [organizacion_id], references: [id])
  lead              lead           @relation(fields: [lead_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  vertical_interes  vertical       @relation(fields: [vertical_interes_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  programa_sugerido programa?      @relation(fields: [programa_sugerido_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  alumno            alumno?        @relation(fields: [alumno_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  cotizaciones      cotizacion[]
  lista_espera      lista_espera[]
  clases_muestra    clase_muestra[]
  registros_clase_muestra registro_clase_muestra[]
  aceptaciones_legales aceptacion_legal[]
  avisos_promocion aviso_promocion[]
  inscripciones inscripcion[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([lead_id])
}

enum tipo_interaccion {
  whatsapp
  llamada
  nota
  cambio_etapa
  pase_a_asesor
  baja
  automatizacion
}

model interaccion {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String           @db.Uuid
  lead_id         String           @db.Uuid
  conversacion_id String?          @db.Uuid
  tipo            tipo_interaccion
  contenido       String?
  datos           Json?
  creado_en       DateTime         @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime?        @db.Timestamptz(6)

  organizacion organizacion  @relation(fields: [organizacion_id], references: [id])
  lead         lead          @relation(fields: [lead_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  conversacion conversacion? @relation(fields: [conversacion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([lead_id, creado_en])
}

// ── Mensajería ─────────────────────────────────────────────────────────────────────────

enum estado_conversacion {
  bot
  en_atencion_humana
  cerrada
  opt_out
}

enum paso_captacion {
  inicio
  nombre
  edad
  sucursal
  /// C6: hay varios programas para su edad y el contacto elige cuál.
  programa
  /// C7: la sucursal elegida no tiene programa para su edad; se le ofrece otra y espera su respuesta.
  otra_sucursal
  /// C8: se le mandó la cotización y elige uno de los horarios.
  horario
  /// C9: eligió un horario lleno y se le pregunta si quiere entrar a la lista de espera.
  lista_espera
  /// D1: se le propusieron fechas de clase muestra y espera su elección.
  fecha_muestra
  completo
}

model conversacion {
  id                            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id               String              @db.Uuid
  bandeja_chatwoot_id           String              @db.Uuid
  lead_id                       String              @db.Uuid
  /// Id visible de la conversación en Chatwoot (display_id, único por cuenta).
  chatwoot_conversacion_id      Int
  /// en_atencion_humana bloquea toda automatización (invariante 6).
  estado                        estado_conversacion @default(bot)
  paso_captacion                paso_captacion      @default(inicio)
  intentos_fallidos             Int                 @default(0)
  /// El backend debe pasar la conversación a un asesor en cuanto termine de despachar.
  pasar_a_asesor_pendiente      Boolean             @default(false)
  motivo_pase_asesor            String?
  /// A los 30 min sin respuesta a mitad de la captura se avisa a los asesores (nota con los datos
  /// parciales). VISIBLE NO ES ATENDIDO: no cambia `estado`; el bot sigue si el contacto vuelve y
  /// el reenganche puede salir. Es la marca del aviso: lo hace idempotente.
  visible_a_asesores_en         DateTime?           @db.Timestamptz(6)
  /// Cuándo se abrió la conversación en Chatwoot para los asesores. Nulo con `visible_a_asesores_en`
  /// puesto = falta abrirla (se reintenta).
  abierta_para_asesores_en      DateTime?           @db.Timestamptz(6)
  /// Invariante 5, ventana 1: 24 h desde el último mensaje entrante. Decide si se puede
  /// mandar mensaje libre.
  ventana_servicio_hasta        DateTime?           @db.Timestamptz(6)
  /// Invariante 5, ventana 2: 72 h desde la entrada por anuncio Click-to-WhatsApp. Solo
  /// afecta el costo; nunca habilita un envío.
  ventana_gratis_hasta          DateTime?           @db.Timestamptz(6)
  ultimo_mensaje_entrante_en    DateTime?           @db.Timestamptz(6)
  ultimo_mensaje_saliente_en    DateTime?           @db.Timestamptz(6)
  /// Control de concurrencia optimista: dos webhooks de la misma conversación no se pisan.
  version                       Int                 @default(0)
  /// Agente de Chatwoot al que está asignada la conversación (lo que dice el evento de asignación).
  asignada_a_agente_chatwoot_id Int?
  /// El usuario del sistema que corresponde a ese agente (`usuario.chatwoot_agent_id`), si lo hay. Así
  /// se sabe qué asesor tiene cada conversación. Nulo si nadie la tiene o el agente no está vinculado.
  asignada_a_usuario_id         String?             @db.Uuid
  /// D1: las fechas de clase muestra que el bot le propuso al contacto (grupo y sesiones, tal como se las numeró), para que
  /// el número que responda apunte a lo que vio aunque pasen las horas. `{ grupo_id, fechas: [ISO…] }`; nulo si no hay.
  muestra_ofrecida              Json?
  creado_en                     DateTime            @default(now()) @db.Timestamptz(6)
  actualizado_en                DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en                  DateTime?           @db.Timestamptz(6)

  organizacion     organizacion     @relation(fields: [organizacion_id], references: [id])
  bandeja_chatwoot bandeja_chatwoot @relation(fields: [bandeja_chatwoot_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  lead             lead             @relation(fields: [lead_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  asignada_a       usuario?         @relation("conversacion_asignada", fields: [asignada_a_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  mensajes         mensaje[]
  interacciones    interaccion[]
  tareas_asesor    tarea_asesor[]
  eventos_inesperados evento_inesperado[]
  cotizaciones     cotizacion[]
  clases_muestra   clase_muestra[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([lead_id])
}

enum direccion_mensaje {
  entrante
  saliente
  nota_interna
}

/// Por qué existe un saliente. Decide qué reglas le aplica MessagingProvider: la horaria y la
/// de frecuencia son solo para `automatizacion` (invariante 14); la confirmación de una baja es
/// el único mensaje que sale a quien ya pidió la baja.
enum origen_mensaje {
  respuesta
  automatizacion
  confirmacion_baja
}

enum estatus_mensaje {
  recibido
  pendiente
  enviando
  enviado
  entregado
  leido
  bloqueado
  fallido
}

model mensaje {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id  String            @db.Uuid
  conversacion_id  String            @db.Uuid
  plantilla_id     String?           @db.Uuid
  direccion        direccion_mensaje
  estatus          estatus_mensaje
  origen           origen_mensaje    @default(respuesta)
  cuerpo           String
  variables_usadas Json?
  /// Proveedor que dio el id externo (hoy solo "chatwoot").
  proveedor        String
  /// Id del mensaje en el proveedor. Para los entrantes es la llave de idempotencia (invariante 8).
  id_externo       String?
  /// Id del proveedor de mensajería (el MessageSid de Twilio) cuando un evento de entrega lo
  /// trae. Permite que otra fuente de estados (callback directo de Twilio) encuentre el mensaje.
  id_proveedor     String?
  motivo_bloqueo   String?
  error            String?
  error_codigo     Int?
  /// Orden de registro. creado_en no sirve: now() es igual para todo lo que se inserta en una
  /// misma transacción.
  secuencia        BigInt            @default(autoincrement())
  creado_en        DateTime          @default(now()) @db.Timestamptz(6)
  enviado_en       DateTime?         @db.Timestamptz(6)
  entregado_en     DateTime?         @db.Timestamptz(6)
  leido_en         DateTime?         @db.Timestamptz(6)
  actualizado_en   DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en     DateTime?         @db.Timestamptz(6)

  organizacion  organizacion               @relation(fields: [organizacion_id], references: [id])
  conversacion  conversacion               @relation(fields: [conversacion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  plantilla     plantilla_mensaje?         @relation(fields: [plantilla_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  ejecuciones   automatizacion_ejecucion[]
  tareas_asesor tarea_asesor[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([conversacion_id, secuencia])
}

enum estado_consentimiento {
  opt_in
  opt_out
}

enum alcance_consentimiento {
  todo
  marketing
}

/// Bitácora de consentimiento por teléfono. El estado vigente es la fila más reciente por
/// (organizacion_id, telefono, alcance). Una baja aplica a TODA la organización, no a la
/// vertical que recibió el mensaje.
model consentimiento {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String                 @db.Uuid
  /// E.164, de normalizarTelefono() (invariante 7).
  telefono        String
  canal           String                 @default("whatsapp")
  estado          estado_consentimiento
  alcance         alcance_consentimiento @default(todo)
  /// ctwa / formulario / manual / palabra_clave
  origen          String?
  evidencia       Json?
  fecha           DateTime               @default(now()) @db.Timestamptz(6)
  creado_en       DateTime               @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime?              @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])

  @@unique([id, organizacion_id])
  @@index([organizacion_id, telefono, alcance, fecha(sort: Desc)])
}

enum categoria_plantilla {
  marketing
  utility
  authentication
  servicio
}

/// INV-6: lo que una plantilla DECLARA ser, independiente de su categoría ante Meta. `servicio` = aviso sobre algo que la familia ya acordó
/// (recordatorio de clase muestra, bienvenida de inscripción, recordatorio de pago): sale aunque una persona atienda la conversación.
/// `marketing` = todo lo demás (reenganche, lead frío, promoción, recuperación): con una persona atendiendo no sale. Ante la duda, `marketing`.
enum clase_mensaje {
  servicio
  marketing
}

enum estado_aprobacion_plantilla {
  pendiente
  aprobada
  rechazada
  pausada
  deshabilitada
}

/// Plantillas aprobadas (Twilio Content Templates). Solo se envía lo aprobado y activo.
model plantilla_mensaje {
  id                String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id   String                      @db.Uuid
  codigo            String
  content_sid       String
  /// Nulo = sirve para todas las verticales.
  vertical_id       String?                     @db.Uuid
  categoria         categoria_plantilla
  /// Servicio o marketing (INV-6). NOT NULL y sin valor por omisión: quien da de alta la plantilla la DECLARA. Una `servicio` no puede ser de
  /// categoría `marketing` (CHECK en la migración).
  clase_mensaje     clase_mensaje
  /// text / quick-reply / list-picker / call-to-action / media (CHECK en la migración).
  tipo_content      String                      @default("text")
  idioma            String                      @default("es_MX")
  /// [{"pos":1,"nombre":"nombre_prospecto"}]
  variables         Json                        @default("[]")
  cuerpo_referencia String?
  estado_aprobacion estado_aprobacion_plantilla @default(pendiente)
  sincronizado_en   DateTime?                   @db.Timestamptz(6)
  activo            Boolean                     @default(true)
  creado_en         DateTime                    @default(now()) @db.Timestamptz(6)
  actualizado_en    DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en      DateTime?                   @db.Timestamptz(6)

  organizacion     organizacion     @relation(fields: [organizacion_id], references: [id])
  vertical         vertical?        @relation(fields: [vertical_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  mensajes         mensaje[]
  automatizaciones automatizacion[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
}

enum evento_disparador {
  lead_sin_respuesta
  /// Antes de una clase muestra agendada (D3). `offset_minutos` es NEGATIVO (-1440 = 24 h antes). La entidad es la `clase_muestra`.
  clase_muestra_proxima
  /// Cuando se marca que el lead NO llegó a su clase muestra (D4): la recuperación (ofrecerle reagendar). `offset_minutos` es POSITIVO
  /// (minutos después de marcarlo); el primer intento sale en `offset_minutos`, los siguientes cada `espaciado_minutos`, hasta `max_intentos`.
  clase_muestra_no_asistio
  /// Un lead sin movimiento por los días que marca su etapa (D8). La entidad es el `lead`. `offset_minutos` = minutos EXTRA después de cumplirse el umbral (0 por omisión).
  lead_frio
  /// Una promoción de la cotización vigente de un lead está por vencer (D8). La entidad es el `aviso_promocion`. `offset_minutos` NEGATIVO: -4320 = 3 días antes de que acabe la promoción.
  promocion_por_vencer
  /// Se acaba de inscribir un alumno (F7): la bienvenida de inscripción al tutor responsable. La entidad es la `inscripcion`; `offset_minutos` = minutos
  /// después de inscribirse (0 = en cuanto el horario de envío lo permita). Es un aviso de SERVICIO sobre algo ya acordado (plantilla `utility`), no marketing.
  inscripcion_creada
  /// Antes de vencer un cargo (H6): el recordatorio de pago. La entidad es el `cargo`; `offset_minutos` NEGATIVO se mide desde el inicio del día de vencimiento (-4320 = 3 días antes).
  cargo_por_vencer
  /// Después de vencer un cargo (H6): el recordatorio de pago atrasado. La entidad es el `cargo`; `offset_minutos` se mide desde el inicio del día siguiente al vencimiento y los
  /// intentos siguientes salen cada `espaciado_minutos` (7 días por omisión), hasta `max_intentos`.
  cargo_vencido
  /// Una PERSONA reprogramó una clase muestra (V2): aviso de SERVICIO a la familia con la fecha nueva. La entidad es la clase NUEVA (el aviso es único por clase); `offset_minutos`
  /// = minutos después del cambio (0 = en cuanto el horario de envío lo permita). Si la familia misma reprogramó (el bot), no hay aviso.
  clase_muestra_reprogramada
  /// Una PERSONA canceló una clase muestra (V2): aviso de SERVICIO a la familia. La entidad es la clase cancelada; mismo desfase que el de reprogramada.
  clase_muestra_cancelada
}

/// Reglas de automatización configurables. Hoy solo el reenganche (Fase 1.6); los demás
/// disparadores entran con su fase.
model automatizacion {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id   String            @db.Uuid
  nombre            String
  vertical_id       String?           @db.Uuid
  sucursal_id       String?           @db.Uuid
  evento_disparador evento_disparador
  /// Minutos desde el evento. Negativo = antes del evento.
  offset_minutos    Int               @default(0)
  plantilla_id      String?           @db.Uuid
  condiciones       Json              @default("{}")
  max_intentos      Int               @default(1)
  /// Ventana de envío en minutos desde la medianoche, hora local de la sucursal. Nunca fuera
  /// de 09:00–20:00 (invariante 14): lo impone un CHECK.
  hora_inicio_min   Int               @default(540)
  hora_fin_min      Int               @default(1200)
  /// 0 = domingo.
  dias_permitidos   Int[]             @default([1, 2, 3, 4, 5, 6])
  /// Minutos entre un intento y el siguiente cuando `max_intentos` es mayor que 1 (D4). Nulo = el mismo `offset_minutos`.
  espaciado_minutos Int?
  activo            Boolean           @default(true)
  creado_en         DateTime          @default(now()) @db.Timestamptz(6)
  actualizado_en    DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en      DateTime?         @db.Timestamptz(6)

  organizacion organizacion               @relation(fields: [organizacion_id], references: [id])
  vertical     vertical?                  @relation(fields: [vertical_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  sucursal     sucursal?                  @relation(fields: [sucursal_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  plantilla    plantilla_mensaje?         @relation(fields: [plantilla_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  ejecuciones  automatizacion_ejecucion[]
  avisos_promocion aviso_promocion[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
}

enum estatus_ejecucion {
  programado
  enviado
  omitido
  /// Recorrerlo al siguiente horario válido lo dejaba después del evento (invariante 14).
  descartado
  fallido
  cancelado
}

/// Una ejecución por automatización, entidad y ocurrencia. La unicidad es la idempotencia
/// (invariante 8): un reintento nunca manda dos veces.
model automatizacion_ejecucion {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id   String            @db.Uuid
  automatizacion_id String            @db.Uuid
  /// lead / conversacion. Sin llave foránea: la entidad depende del tipo.
  entidad_tipo      String
  entidad_id        String            @db.Uuid
  ocurrencia        Int               @default(1)
  programado_para   DateTime          @db.Timestamptz(6)
  ejecutado_en      DateTime?         @db.Timestamptz(6)
  /// Cuántas veces se reclamó la ejecución (el motor al ejecutarla, el recuperador al resolverla).
  /// Es el candado del recuperador: se compara este contador, no una fecha (EA-20: un `Date` de
  /// JavaScript tiene milisegundos y la columna microsegundos, así que la igualdad nunca coincidía).
  reclamos          Int               @default(0)
  estatus           estatus_ejecucion @default(programado)
  /// fuera_de_ventana / opt_out / atencion_humana / tope_frecuencia / sin_plantilla / evento_pasado
  motivo_omision    String?
  mensaje_id        String?           @db.Uuid
  creado_en         DateTime          @default(now()) @db.Timestamptz(6)
  actualizado_en    DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en      DateTime?         @db.Timestamptz(6)

  organizacion   organizacion   @relation(fields: [organizacion_id], references: [id])
  automatizacion automatizacion @relation(fields: [automatizacion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  mensaje        mensaje?       @relation(fields: [mensaje_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@unique([automatizacion_id, entidad_tipo, entidad_id, ocurrencia], map: "automatizacion_ejecucion_idempotencia_key")
  @@index([organizacion_id])
}

enum tipo_tarea_asesor {
  sin_plantilla_apta
  /// Genérico y heredado de la noche 1. Lo nuevo usa un tipo por causa (EA-14): una tarea pendiente
  /// de una causa no se traga el aviso de otra.
  revision_manual
  /// Alguien dado de baja volvió a escribir. El sistema no contesta; una persona decide (A4).
  baja_volvio_a_escribir
  /// Un evento de entrega marcó un mensaje como fallido (A5). Una por mensaje, con el código de error.
  entrega_fallida
  /// Un mensaje al contacto quedó a medias y no se sabe si salió (envío incierto). No se reenvía.
  envio_incierto
  /// Una automatización no se le mandó al contacto por un problema de configuración o de datos.
  automatizacion_omitida
  /// El contacto pidió la baja mientras lo atendía una persona: el sistema no contesta, la persona confirma.
  baja_solicitada
  /// No se pudo publicar una nota interna para los asesores (p. ej. el resumen del aviso de 30 min).
  nota_fallida
  /// Alguien entró a la lista de espera de un grupo lleno (C9).
  lista_espera_nueva
  /// Se liberó un lugar y le toca al siguiente de la lista: el asesor se lo ofrece (C9).
  lista_espera_lugar_liberado
  /// El aviso de una clase muestra al maestro no salió por WhatsApp (sin teléfono, sin plantilla apta, fallo del envío) (D2). El maestro lo ve igual en la aplicación.
  aviso_maestro_no_enviado
  /// Llamar a la familia que no llegó a su clase muestra para ofrecerle reagendar (D4). Una pendiente por clase.
  llamar_no_asistio
  /// Un lead lleva sin movimiento los días que marca su etapa: el asesor decide cómo retomarlo (D8). Una pendiente por lead.
  lead_frio
  /// El maestro (o el asesor) marcó que la familia quedó lista para cerrar la inscripción (F6). Una pendiente por lead; se resuelve sola al convertirse.
  listo_para_cerrar
  /// Una inscripción llegó al umbral de faltas consecutivas (G2). Una pendiente por inscripción y una por racha; se resuelve sola al volver a asistir.
  faltas_consecutivas
  /// Llegó por un webhook o la landing algo con datos inesperados que el sistema no pudo procesar (WH). Una pendiente por conversación.
  evento_inesperado
  /// Se canceló el pago que cumplió la condición de un beneficio que ya se había entregado (H4). Una pendiente por inscripción: una persona decide.
  beneficio_en_revision
  /// Una familia lleva más de `umbral_dias_deuda` días de atraso (H6). Una pendiente por familia, ligada a su cargo vencido más antiguo; se resuelve sola al saldarse.
  deuda_vencida
  /// No hay una conversación de WhatsApp a la cual mandar el recordatorio de pago (H6): una persona cobra. Una pendiente por cargo.
  cobranza_sin_canal
  /// Una persona cambió o canceló una clase muestra y el aviso por WhatsApp no pudo salir (fuera de horario con la clase encima, sin conversación, tope de mensajes del día) (V2):
  /// el asesor llama a la familia. Una pendiente por clase.
  avisar_cambio_de_clase
}

enum estado_tarea_asesor {
  pendiente
  hecha
  descartada
}

/// Trabajo que el sistema no puede hacer solo y deja a una persona (p. ej. el contacto está
/// fuera de la ventana de servicio y no hay plantilla apta).
model tarea_asesor {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String              @db.Uuid
  /// Nulo solo en la tarea de un evento inesperado (WH) que no se pudo atar a ningún lead: lo ve el administrador.
  lead_id         String?             @db.Uuid
  conversacion_id String?             @db.Uuid
  /// Mensaje al que se refiere la tarea (entrega fallida). Una tarea por mensaje y tipo.
  mensaje_id      String?             @db.Uuid
  /// La clase muestra a la que se refiere la tarea (aviso al maestro que no salió, quien no llegó).
  clase_muestra_id String?            @db.Uuid
  /// La inscripción a la que se refiere la tarea (faltas consecutivas, G2).
  inscripcion_id  String?             @db.Uuid
  /// El cargo al que se refiere la tarea (deuda vencida, recordatorio sin canal; H6).
  cargo_id        String?             @db.Uuid
  /// Desde cuándo corre lo que la tarea avisa (faltas consecutivas: la fecha de la PRIMERA falta de la racha). Con `inscripcion_id` y `tipo` hace única la tarea de una racha.
  referencia_fecha DateTime?          @db.Date
  tipo            tipo_tarea_asesor
  estado          estado_tarea_asesor @default(pendiente)
  descripcion     String
  /// Código de error del proveedor (p. ej. 63016 de Twilio), cuando la tarea nace de un fallo de entrega.
  codigo_error    Int?
  vence_en        DateTime?           @db.Timestamptz(6)
  resuelta_en     DateTime?           @db.Timestamptz(6)
  creado_en       DateTime            @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime?           @db.Timestamptz(6)

  organizacion organizacion  @relation(fields: [organizacion_id], references: [id])
  lead         lead?         @relation(fields: [lead_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  conversacion conversacion? @relation(fields: [conversacion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  mensaje      mensaje?      @relation(fields: [mensaje_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  clase_muestra clase_muestra? @relation(fields: [clase_muestra_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  inscripcion  inscripcion?  @relation(fields: [inscripcion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  cargo        cargo?        @relation(fields: [cargo_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  eventos_inesperados evento_inesperado[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([estado, vence_en])
}

enum tipo_evento_twilio {
  entrante
  estado
}

enum estado_proceso_evento {
  procesando
  reenviado
  fallido
  /// Se agotaron los reintentos del barrido de reenvío (EA-03). Queda guardado y con alerta; una persona decide.
  abandonado
}

/// Webhook de Twilio recibido por el borde (A7) y reenviado a Chatwoot. Es la idempotencia del
/// borde (invariante 8): único por (proveedor, tipo, id_mensaje, estado_mensaje), así que un
/// reintento de Twilio llega a Chatwoot UNA sola vez. `procesando` = reclamado por un proceso;
/// `reenviado` = Chatwoot lo aceptó; `fallido` = el reenvío falló y un reintento puede reclamarlo.
model evento_twilio {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String                @db.Uuid
  proveedor       String                @default("twilio")
  tipo            tipo_evento_twilio
  /// MessageSid del evento.
  id_mensaje      String
  /// MessageStatus de un estado de entrega; vacío en los entrantes.
  estado_mensaje  String                @default("")
  /// Número de WhatsApp de la escuela con el que se resolvió la organización.
  numero_receptor String?
  estado_proceso  estado_proceso_evento @default(procesando)
  /// Cuerpo y cabeceras tal como llegaron, guardados MIENTRAS el evento no se haya reenviado (EA-03):
  /// con ellos el barrido de reenvío puede reintentar sin que Twilio vuelva a llamar. Se borran al
  /// reenviarlo: son datos de contacto y ya no hacen falta.
  cuerpo          Bytes?
  cabeceras       Json?
  /// Cuántas veces se reclamó el evento. Es también el candado del reclamo vencido: se compara este
  /// contador, no una fecha (EA-20).
  intentos        Int                   @default(1)
  reclamado_en    DateTime              @default(now()) @db.Timestamptz(6)
  reenviado_en    DateTime?             @db.Timestamptz(6)
  error           String?
  creado_en       DateTime              @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime?             @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
}

enum estado_evento_entrega {
  enviado
  entregado
  leido
  fallido
}

/// Estado de entrega que llegó ANTES de que MessagingProvider guardara el id del mensaje (F1-03).
/// No se pierde: se guarda aquí y se concilia cuando el provider guarda el id. Los que nunca
/// encuentran mensaje (p. ej. los de un mensaje de un asesor) se descartan por antigüedad con
/// eliminado_en. Único por (organizacion, proveedor, id_externo, estado): repetir el evento no duplica.
model evento_entrega_pendiente {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String                @db.Uuid
  proveedor       String
  id_externo      String
  id_proveedor    String?
  estado          estado_evento_entrega
  /// Cuándo ocurrió según la fuente; nulo si no lo dice (entonces cuenta la hora de recepción: creado_en).
  ocurrio_en      DateTime?             @db.Timestamptz(6)
  error_codigo    Int?
  error_texto     String?
  conciliado_en   DateTime?             @db.Timestamptz(6)
  creado_en       DateTime              @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime?             @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])

  @@unique([id, organizacion_id])
  @@index([organizacion_id, proveedor, id_externo])
}

// ── Catálogo (Fase 2, solo lo que pide N11: sin precios, promociones ni cotizador) ───────

/// Un programa es lo que se ofrece a un rango de edad en una sucursal. Sus textos y nombres viven
/// aquí, no en código (invariante 2).
model programa {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id     String    @db.Uuid
  vertical_id         String    @db.Uuid
  sucursal_id         String    @db.Uuid
  nombre              String
  /// Años cumplidos, ambos inclusive.
  edad_min            Int
  edad_max            Int
  nivel               String?
  descripcion_publica String?
  /// Verdadero = este programa convive con otros para una misma edad en su vertical y sucursal: son ALTERNATIVAS
  /// (un estilo, no un rango de edad) y el cotizador pregunta cuál (decisión 9 del plan). Si dos programas de la
  /// misma vertical y sucursal se traslapan en edad y NO ambos lo permiten, es un error del catálogo.
  permite_traslape    Boolean   @default(false)
  /// Fecha en la que se mide la edad de quien se inscribe (p. ej. el inicio del ciclo): la edad se calcula a esa
  /// fecha a partir de la fecha de nacimiento, no a hoy. Nula = a la fecha de la consulta. Si solo se conoce la
  /// edad que declaró el contacto, se usa tal cual (C5).
  fecha_corte_edad    DateTime? @db.Date
  activo              Boolean   @default(true)
  creado_en           DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en        DateTime? @db.Timestamptz(6)

  organizacion         organizacion         @relation(fields: [organizacion_id], references: [id])
  vertical             vertical             @relation(fields: [vertical_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  sucursal             sucursal             @relation(fields: [sucursal_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  grupos               grupo[]
  precios              precio[]
  promociones          promocion_programa[]
  prospectos_sugeridos prospecto[]
  cotizaciones         cotizacion[]
  inscripciones        inscripcion[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
}

/// Precio de un programa, VERSIONADO por fecha (C2). Una vigencia va de `vigencia_desde` a `vigencia_hasta`
/// (ambas inclusivas, fechas del calendario local de la escuela); `vigencia_hasta` nula = abierta. Las
/// vigencias de un programa NO se traslapan: lo impone una restricción de exclusión (btree_gist) en la
/// migración. Dinero en `Decimal(12,2)`; en código siempre en centavos (`src/lib/dinero.ts`).
/// Cambiar el precio = una vigencia nueva (la anterior se cierra el día previo), nunca editar el pasado:
/// lo ya inscrito congela su precio (F3).
model precio {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id   String    @db.Uuid
  programa_id       String    @db.Uuid
  costo_inscripcion Decimal   @db.Decimal(12, 2)
  costo_mensualidad Decimal   @db.Decimal(12, 2)
  moneda            String    @default("MXN")
  vigencia_desde    DateTime  @db.Date
  vigencia_hasta    DateTime? @db.Date
  creado_en         DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en      DateTime? @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  programa     programa     @relation(fields: [programa_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([programa_id, vigencia_desde])
}

/// Un grupo es una opción de horario de un programa. "Lun-Mié o Mar-Jue" son dos grupos.
model grupo {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id      String    @db.Uuid
  programa_id          String    @db.Uuid
  nombre               String
  /// Salón donde se imparte (de la MISMA sucursal que el programa: lo garantiza un disparador). Dos grupos activos
  /// no pueden usar el mismo salón en franjas que se traslapan (disparador `grupo_choque_*`, C1).
  salon_id             String?   @db.Uuid
  cupo_maximo          Int
  permite_lista_espera Boolean   @default(false)
  /// Quién imparte el grupo. Opcional: un grupo puede no tener instructor asignado todavía.
  instructor_id        String?   @db.Uuid
  activo               Boolean   @default(true)
  creado_en            DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en         DateTime? @db.Timestamptz(6)

  organizacion          organizacion    @relation(fields: [organizacion_id], references: [id])
  programa              programa        @relation(fields: [programa_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  instructor            instructor?     @relation(fields: [instructor_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  salon                 salon?          @relation(fields: [salon_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  horarios              grupo_horario[]
  cotizaciones_elegidas cotizacion[]
  lista_espera          lista_espera[]
  clases_muestra        clase_muestra[]
  registros_recomendado registro_clase_muestra[]
  inscripciones         inscripcion[]
  movimientos_desde     inscripcion_movimiento[] @relation("movimiento_grupo_anterior")
  movimientos_hacia     inscripcion_movimiento[] @relation("movimiento_grupo_nuevo")

  asistencias           asistencia[]
  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([programa_id])
}

/// Un grupo puede sesionar varios días: nunca van como texto en `grupo`.
model grupo_horario {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String    @db.Uuid
  grupo_id        String    @db.Uuid
  /// 0 = domingo … 6 = sábado.
  dia_semana      Int
  /// Minutos desde la medianoche local de la sucursal.
  hora_inicio_min Int
  hora_fin_min    Int
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime? @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  grupo        grupo        @relation(fields: [grupo_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([grupo_id])
}

// ── Promociones (C3) ───────────────────────────────────────────────────────────────────

enum condicion_promocion {
  sin_condicion
  al_pagar_primera_mensualidad
  min_hermanos
  pago_anticipado
}

enum tipo_beneficio {
  descuento_inscripcion
  descuento_mensualidad
  producto_gratis
  meses_gratis
}

enum modo_beneficio {
  porcentaje
  monto_fijo
  total
}

enum momento_disparo {
  inmediato
  al_cumplir_condicion
}

enum estatus_aplicacion {
  pendiente
  /// H4: la condición se cumplió (se saldó la primera mensualidad) y recepción debe entregarlo. Nace `pendiente`, pasa a `liberado` con el pago y a `entregado` al dárselo a la familia.
  liberado
  entregado
}

/// Una promoción NO es un campo de descuento: es una regla con vigencia, alcance, condición y uno o más
/// beneficios (`promocion_beneficio`). Alcance por tablas puente (vacío = todos). `condicion_valor` es JSON
/// validado según `condicion_tipo` (src/promociones/condicion.ts). El cupo se consume de forma atómica
/// (`consumirCupo`) y la base impide pasarse de `cupo_maximo`. El código es único entre las vivas.
/// La lógica que decide qué promociones aplican y cuánto descuentan es PURA (src/promociones/resolver.ts).
model promocion {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String              @db.Uuid
  nombre          String
  codigo          String
  vigencia_desde  DateTime            @db.Date
  vigencia_hasta  DateTime?           @db.Date
  condicion_tipo  condicion_promocion @default(sin_condicion)
  /// `min_hermanos`: { "hermanos": n }; `pago_anticipado`: { "meses": n }; las demás: nulo.
  condicion_valor Json?
  cupo_maximo     Int?
  cupo_usado      Int                 @default(0)
  /// Las acumulables se suman entre sí; una NO acumulable no se combina con ninguna otra (V2): compite sola por `prioridad` (mayor gana; empate: más beneficio al cliente; luego menor id).
  acumulable      Boolean             @default(false)
  prioridad       Int                 @default(0)
  activo          Boolean             @default(true)
  creado_en       DateTime            @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime?           @db.Timestamptz(6)

  organizacion organizacion           @relation(fields: [organizacion_id], references: [id])
  verticales   promocion_vertical[]
  sucursales   promocion_sucursal[]
  programas    promocion_programa[]
  beneficios   promocion_beneficio[]
  aplicaciones promocion_aplicacion[]
  inscripciones inscripcion[]
  avisos_por_vencer aviso_promocion[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
}

/// Alcance de una promoción por vertical. Sin filas en las tres tablas puente = vale en todas partes.
model promocion_vertical {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String    @db.Uuid
  promocion_id    String    @db.Uuid
  vertical_id     String    @db.Uuid
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime? @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  promocion    promocion    @relation(fields: [promocion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  vertical     vertical     @relation(fields: [vertical_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([promocion_id])
}

model promocion_sucursal {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String    @db.Uuid
  promocion_id    String    @db.Uuid
  sucursal_id     String    @db.Uuid
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime? @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  promocion    promocion    @relation(fields: [promocion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  sucursal     sucursal     @relation(fields: [sucursal_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([promocion_id])
}

model promocion_programa {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String    @db.Uuid
  promocion_id    String    @db.Uuid
  programa_id     String    @db.Uuid
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime? @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  promocion    promocion    @relation(fields: [promocion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  programa     programa     @relation(fields: [programa_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([promocion_id])
}

/// Lo que una promoción otorga. «Inscripción gratis + uniforme gratis al pagar la primera mensualidad» son DOS filas.
/// Combinaciones válidas (CHECK en la migración): descuento_inscripcion y descuento_mensualidad con modo
/// `porcentaje` (valor 0–100, dos decimales), `monto_fijo` (valor > 0) o `total` (sin valor; gratis);
/// `producto_gratis` con modo `total` y sin valor; `meses_gratis` con modo `total` y valor = número de meses
/// (entero 1–24). `descuento_mensualidad` rige en CADA mensualidad; `meses_gratis` deja gratis las primeras n.
model promocion_beneficio {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String          @db.Uuid
  promocion_id    String          @db.Uuid
  tipo            tipo_beneficio
  modo            modo_beneficio
  valor           Decimal?        @db.Decimal(12, 2)
  /// H5: el producto del catálogo que se entrega (llave foránea compuesta, agregada sin validar las filas de antes de existir `producto`); nulo si el beneficio solo dice qué
  /// es en `descripcion` («Uniforme») y recepción elige la talla al entregar.
  producto_id     String?         @db.Uuid
  descripcion     String?
  momento_disparo momento_disparo @default(inmediato)
  creado_en       DateTime        @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime?       @db.Timestamptz(6)

  organizacion organizacion           @relation(fields: [organizacion_id], references: [id])
  promocion    promocion              @relation(fields: [promocion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  producto     producto?              @relation(fields: [producto_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  aplicaciones promocion_aplicacion[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([promocion_id])
}

/// Auditoría: qué beneficio de qué promoción se aplicó a qué inscripción, quién lo autorizó y si el diferido ya
/// se entregó. `inscripcion_id` es la inscripción (F3; la llave se agregó sin validar las filas de antes de existir la tabla). Única entre las
/// vivas por (inscripción, beneficio): un reintento no duplica (invariante 8).
model promocion_aplicacion {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id   String             @db.Uuid
  inscripcion_id    String             @db.Uuid
  promocion_id      String             @db.Uuid
  beneficio_id      String             @db.Uuid
  estatus           estatus_aplicacion @default(pendiente)
  fecha_entrega     DateTime?          @db.Timestamptz(6)
  autorizado_por_id String?            @db.Uuid
  /// Lo que valió este beneficio al inscribir, CONGELADO (F3): el descuento en dinero (0 si no es un descuento) y los meses gratis (0 si no
  /// aplica). La promoción puede cambiar después; lo ya inscrito conserva lo que se le prometió.
  descuento         Decimal            @default(0) @db.Decimal(12, 2)
  meses_gratis      Int                @default(0)
  /// H4: cuándo y con qué pago se cumplió la condición (nulo mientras esté pendiente) y quién lo entregó.
  liberado_en          DateTime?       @db.Timestamptz(6)
  liberado_por_pago_id String?         @db.Uuid
  entregado_por_usuario_id String?     @db.Uuid
  /// H4: se canceló el pago que lo liberó cuando ya estaba entregado: una persona decide (tarea `beneficio_en_revision`).
  revision_en       DateTime?          @db.Timestamptz(6)
  creado_en         DateTime           @default(now()) @db.Timestamptz(6)
  actualizado_en    DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en      DateTime?          @db.Timestamptz(6)

  organizacion   organizacion        @relation(fields: [organizacion_id], references: [id])
  promocion      promocion           @relation(fields: [promocion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  beneficio      promocion_beneficio @relation(fields: [beneficio_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  autorizado_por usuario?            @relation("aplicacion_autorizada_por", fields: [autorizado_por_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  inscripcion    inscripcion         @relation(fields: [inscripcion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  liberado_por_pago pago?            @relation("aplicacion_liberada_por", fields: [liberado_por_pago_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  entregado_por  usuario?            @relation("aplicacion_entregada_por", fields: [entregado_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  ventas         venta[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([inscripcion_id])
}

// ── Usuarios, roles y sesiones (B1) ────────────────────────────────────────────────────

enum rol_usuario {
  administrador
  asesor
  maestro
  recepcion
}

/// Persona que entra al sistema con correo y contraseña. El correo va normalizado en minúsculas y es
/// único entre los usuarios vivos de la organización (índice parcial en la migración). La contraseña
/// NUNCA se guarda ni se registra: solo `contrasena_hash` (scrypt con sal propia, src/auth/contrasena.ts).
model usuario {
  id                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id        String      @db.Uuid
  correo                 String
  nombre                 String
  rol                    rol_usuario
  contrasena_hash        String
  activo                 Boolean     @default(true)
  contrasena_cambiada_en DateTime?   @db.Timestamptz(6)
  /// Id del agente de Chatwoot de esta persona (único entre los usuarios vivos de la organización).
  chatwoot_agent_id      Int?
  creado_en              DateTime    @default(now()) @db.Timestamptz(6)
  actualizado_en         DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en           DateTime?   @db.Timestamptz(6)

  organizacion             organizacion           @relation(fields: [organizacion_id], references: [id])
  sucursales               usuario_sucursal[]
  sesiones                 sesion[]
  instructores             instructor[]
  cambios                  registro_cambio[]
  accesos_dato_sensible    acceso_dato_sensible[]
  conversaciones_asignadas conversacion[]         @relation("conversacion_asignada")
  aplicaciones_autorizadas promocion_aplicacion[] @relation("aplicacion_autorizada_por")
  cotizaciones             cotizacion[]           @relation("cotizacion_creada_por")
  clases_muestra_agendadas clase_muestra[]        @relation("clase_agendada_por")
  clases_muestra_marcadas  clase_muestra[]        @relation("clase_asistencia_por")
  registros_creados        registro_clase_muestra[] @relation("registro_creado_por")
  registros_cerrados       registro_clase_muestra[] @relation("registro_cerrado_por")
  documentos_legales_creados documento_legal[]     @relation("documento_creado_por")
  aceptaciones_capturadas  aceptacion_legal[]      @relation("aceptacion_capturada_por")
  cambios_de_etapa         lead_etapa_historial[]  @relation("historial_usuario")
  inscripciones_creadas    inscripcion[]           @relation("inscripcion_creada_por")
  inscripciones_movidas    inscripcion_movimiento[] @relation("movimiento_usuario")
  clases_listas_para_cerrar clase_muestra[]          @relation("clase_listo_por")

  asistencias_registradas asistencia[] @relation("asistencia_registrada_por")
  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  progresiones_registradas alumno_progresion[] @relation("progresion_registrada_por")
  eventos_creados evento[] @relation("evento_creado_por")
  participaciones_registradas evento_alumno[] @relation("evento_alumno_registrado_por")
  cargos_creados cargo[] @relation("cargo_creado_por")
  cargos_cancelados cargo[] @relation("cargo_cancelado_por")
  pagos_registrados pago[] @relation("pago_registrado_por")
  pagos_cancelados pago[] @relation("pago_cancelado_por")
  beneficios_entregados promocion_aplicacion[] @relation("aplicacion_entregada_por")
  ventas_registradas venta[] @relation("venta_registrada_por")
  ventas_anuladas venta[] @relation("venta_anulada_por")
  gastos_capturados gasto_campana[] @relation("gasto_creado_por")
}

/// Sucursales que ve un usuario. El administrador ve todas sin necesidad de filas aquí.
model usuario_sucursal {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String    @db.Uuid
  usuario_id      String    @db.Uuid
  sucursal_id     String    @db.Uuid
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime? @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  usuario      usuario      @relation(fields: [usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  sucursal     sucursal     @relation(fields: [sucursal_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([usuario_id])
}

/// Sesión de un usuario. El token (32 bytes aleatorios) solo viaja en la cookie; aquí se guarda su
/// SHA-256. `revocada_en` cierra la sesión sin borrarla. Expira a las 12 h absolutas y por inactividad.
model sesion {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id     String    @db.Uuid
  usuario_id          String    @db.Uuid
  /// SHA-256 (hex) del token de la cookie. Único: es la llave de búsqueda.
  token_hash          String    @unique
  expira_en           DateTime  @db.Timestamptz(6)
  ultima_actividad_en DateTime  @db.Timestamptz(6)
  revocada_en         DateTime? @db.Timestamptz(6)
  ip                  String?
  agente_usuario      String?
  creado_en           DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en        DateTime? @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  usuario      usuario      @relation(fields: [usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([usuario_id])
}

/// Intento de acceso fallido (o en curso: se reserva antes de verificar la contraseña y se libera al
/// acertar). Cuenta por (correo, IP) para el bloqueo temporal. Se registra también para correos que
/// no existen, para que el bloqueo no delate qué usuarios hay.
model intento_acceso {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String    @db.Uuid
  correo          String
  ip              String
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime? @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([organizacion_id, correo, ip, creado_en])
}

// ── Instructores (B2) ──────────────────────────────────────────────────────────────────

/// Quien imparte grupos. Un maestro (rol) ve solo los grupos cuyo instructor está ligado a su usuario.
/// Un usuario tiene a lo más un instructor vivo (índice parcial en la migración). Trabaja en las
/// sucursales de `instructor_sucursal` (vacío = sin restricción) y no puede estar en dos grupos activos
/// a la misma hora (disparador `grupo_choque_*`, C1).
model instructor {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String    @db.Uuid
  /// El usuario con el que entra, si tiene cuenta. Un instructor puede existir sin usuario.
  usuario_id      String?   @db.Uuid
  nombre          String
  /// E.164 normalizado con `normalizarTelefono()` (invariante 7).
  telefono        String?
  correo          String?
  activo          Boolean   @default(true)
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime? @db.Timestamptz(6)

  organizacion organizacion          @relation(fields: [organizacion_id], references: [id])
  usuario      usuario?              @relation(fields: [usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  grupos       grupo[]
  sucursales   instructor_sucursal[]
  conversaciones conversacion_instructor[]
  avisos       aviso_maestro[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([usuario_id])
  progresiones   alumno_progresion[]
}

/// Sucursales en las que da clases un instructor. Único entre los vivos (índice parcial en la migración).
model instructor_sucursal {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String    @db.Uuid
  instructor_id   String    @db.Uuid
  sucursal_id     String    @db.Uuid
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime? @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  instructor   instructor   @relation(fields: [instructor_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  sucursal     sucursal     @relation(fields: [sucursal_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([instructor_id])
  @@index([sucursal_id])
}

/// Un salón de una sucursal. El nombre es único entre los salones vivos de la sucursal (índice parcial).
model salon {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String    @db.Uuid
  sucursal_id     String    @db.Uuid
  nombre          String
  /// Personas que caben; informativo (el cupo del grupo manda).
  capacidad       Int?
  activo          Boolean   @default(true)
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime? @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  sucursal     sucursal     @relation(fields: [sucursal_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  grupos       grupo[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([sucursal_id])
}

// ── Registro de cambios (B3) ───────────────────────────────────────────────────────────

/// Quién cambió qué. Solo de anexar (un disparador en la migración impide UPDATE y DELETE). `antes` y
/// `despues` guardan SOLO los campos de la lista blanca de su entidad (src/api/registro.ts): nunca
/// contraseñas, tokens ni datos de salud. Se escribe en la MISMA transacción que el cambio.
model registro_cambio {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String    @db.Uuid
  /// Quien hizo el cambio.
  usuario_id      String    @db.Uuid
  /// Nombre de la tabla afectada (`usuario`, `tarea_asesor`…).
  entidad_tipo    String
  entidad_id      String    @db.Uuid
  /// Verbo corto: crear, actualizar, resolver, descartar, cambiar_contrasena…
  accion          String
  antes           Json?
  despues         Json?
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime? @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  usuario      usuario      @relation(fields: [usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([organizacion_id, entidad_tipo, entidad_id])
  @@index([organizacion_id, creado_en])
}

// ── Datos sensibles de salud (B4, decisión 12) ─────────────────────────────────────────

enum sujeto_salud {
  prospecto
  alumno
}

/// Datos de salud de un menor (alergias, condiciones médicas, medicamentos, contacto de emergencia,
/// autorización de atención médica). SENSIBLES: cada columna guarda el valor CIFRADO (AES-256-GCM,
/// ligado a su fila y campo) y NADIE las lee con una consulta normal: el único acceso es
/// `leerSensible()` / `guardarSensible()` de src/sensibles/, que además registra cada acceso.
/// `check:capas` prohíbe nombrar este modelo fuera de src/sensibles/.
/// `sujeto_id` apunta a `prospecto` o a `alumno` según `sujeto_tipo` (referencia polimórfica: no puede
/// ser llave foránea; el servicio comprueba que exista dentro de la organización. La tabla `alumno`
/// llega con F1, que reutiliza esta ficha).
model ficha_salud {
  id                           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id              String       @db.Uuid
  sujeto_tipo                  sujeto_salud
  sujeto_id                    String       @db.Uuid
  alergias                     String?
  condiciones_medicas          String?
  medicamentos                 String?
  contacto_emergencia          String?
  autorizacion_atencion_medica String?
  creado_en                    DateTime     @default(now()) @db.Timestamptz(6)
  actualizado_en               DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en                 DateTime?    @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
}

/// Cada lectura o escritura de datos sensibles: quién, sobre quién, qué campos (solo los NOMBRES),
/// cuándo, por qué y desde qué ruta. Solo de anexar (disparador). También las lecturas denegadas.
model acceso_dato_sensible {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String       @db.Uuid
  usuario_id      String       @db.Uuid
  sujeto_tipo     sujeto_salud
  sujeto_id       String       @db.Uuid
  /// leer o escribir.
  accion          String
  /// permitido o denegado.
  resultado       String
  /// Si fue denegado, por qué: sin_permiso, sujeto_no_encontrado o no_es_de_tu_grupo (EB-01).
  causa           String?
  /// Nombres de los campos tocados. Nunca sus valores.
  campos          String[]
  motivo          String?
  ruta            String?
  creado_en       DateTime     @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime?    @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  usuario      usuario      @relation(fields: [usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([organizacion_id, sujeto_tipo, sujeto_id, creado_en])
}

enum estatus_cotizacion {
  vigente
  aceptada
  vencida
}

enum origen_cotizacion {
  bot
  asesor
}

/// Lo que se le cotizó a una familia (C8): el programa, los horarios con su lugar, los precios y las promociones de
/// ESE día, congelados en `snapshot`. La inscripción (F3) puede respetarlos si se decide. El snapshot no se
/// recalcula: es lo que se dijo, no lo que diría hoy el cotizador.
model cotizacion {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id       String             @db.Uuid
  lead_id               String             @db.Uuid
  prospecto_id          String             @db.Uuid
  programa_id           String             @db.Uuid
  sucursal_id           String             @db.Uuid
  /// De dónde salió: el bot de WhatsApp o un asesor a mano.
  origen                origen_cotizacion
  /// La conversación donde el bot la mandó (nula si la hizo un asesor).
  conversacion_id       String?            @db.Uuid
  /// El asesor que la hizo a mano (nulo si fue el bot).
  creado_por_usuario_id String?            @db.Uuid
  /// El horario (grupo) que eligió el contacto, si lo hay. Siempre de este programa (lo valida el código que lo escribe).
  grupo_elegido_id      String?            @db.Uuid
  /// Fecha de calendario local de la cotización: la de los precios y promociones que se usaron.
  fecha                 DateTime           @db.Date
  /// Último día (inclusive) en que vale: a lo más `fecha + cotizacion_vigencia_dias`, y antes si vence el precio o una promoción que cotizó.
  vigente_hasta         DateTime           @db.Date
  estatus               estatus_cotizacion @default(vigente)
  /// Programa, grupos (lugares y horarios), precio y promociones tal como se cotizaron (importes como texto).
  snapshot              Json
  creado_en             DateTime           @default(now()) @db.Timestamptz(6)
  actualizado_en        DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en          DateTime?          @db.Timestamptz(6)

  organizacion  organizacion  @relation(fields: [organizacion_id], references: [id])
  lead          lead          @relation(fields: [lead_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  prospecto     prospecto     @relation(fields: [prospecto_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  programa      programa      @relation(fields: [programa_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  sucursal      sucursal      @relation(fields: [sucursal_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  conversacion  conversacion? @relation(fields: [conversacion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  creado_por    usuario?      @relation("cotizacion_creada_por", fields: [creado_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  grupo_elegido grupo?        @relation(fields: [grupo_elegido_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  avisos_promocion aviso_promocion[]
  inscripciones inscripcion[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([lead_id])
  @@index([prospecto_id, programa_id])
}

enum estatus_lista_espera {
  /// En la fila, sin lugar todavía.
  esperando
  /// Se liberó un lugar y se le ofreció; tiene hasta `vence_en` para tomarlo.
  ofrecido
  /// Tomó el lugar: se inscribió (F3/F5).
  inscrito
  /// Se quitó de la fila (lo pidió la familia o lo decidió el asesor).
  cancelado
}

/// Fila de espera de un grupo lleno (C9). Una entrada viva (esperando u ofrecido) por (grupo, prospecto). La posición es
/// densa (1..N) entre las vivas y única por grupo; la mantiene el código bajo un candado por grupo y la base impide
/// repetirla. Orden de llegada determinista: la posición nueva es siempre la última.
model lista_espera {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String               @db.Uuid
  grupo_id        String               @db.Uuid
  prospecto_id    String               @db.Uuid
  lead_id         String               @db.Uuid
  estatus         estatus_lista_espera @default(esperando)
  /// 1 = el siguiente en recibir un lugar. Solo cuenta entre las vivas (esperando u ofrecido); al cerrarse una entrada
  /// las demás se recorren.
  posicion        Int
  ofrecido_en     DateTime?            @db.Timestamptz(6)
  vence_en        DateTime?            @db.Timestamptz(6)
  creado_en       DateTime             @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime?            @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  grupo        grupo        @relation(fields: [grupo_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  prospecto    prospecto    @relation(fields: [prospecto_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  lead         lead         @relation(fields: [lead_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([grupo_id])
  @@index([lead_id])
}

// ── Clase muestra (D1) ─────────────────────────────────────────────────────────────────

enum estatus_clase_muestra {
  /// Vigente: ocupa un lugar en su sesión.
  agendada
  asistio
  no_asistio
  /// Se movió a otra fecha (la nueva apunta a esta con `reprogramada_de_id`).
  reagendada
  cancelada
}

enum origen_clase_muestra {
  bot
  usuario
}

/// La clase de prueba de un prospecto en un grupo, en una SESIÓN concreta (`fecha_hora`: un instante, no un día de la
/// semana). Ocupa un lugar de esa sesión mientras está `agendada`: lugares de la sesión = cupo del grupo − ocupados − clases
/// muestra agendadas de esa fecha. La fecha coincide siempre con un `grupo_horario` del grupo en la zona horaria de la
/// sucursal. Un prospecto tiene a lo más una vigente por grupo (índice único parcial en la migración).
/// `notas` NO es para datos de salud (alergias, condiciones, medicamentos): esos van en la ficha cifrada (src/sensibles/).
model clase_muestra {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id         String                @db.Uuid
  lead_id                 String                @db.Uuid
  prospecto_id            String                @db.Uuid
  grupo_id                String                @db.Uuid
  fecha_hora              DateTime              @db.Timestamptz(6)
  estatus                 estatus_clase_muestra @default(agendada)
  agendada_por            origen_clase_muestra
  /// El usuario que la agendó (solo si `agendada_por = usuario`).
  agendada_por_usuario_id String?               @db.Uuid
  /// La conversación donde el bot la agendó (solo si `agendada_por = bot`).
  conversacion_id         String?               @db.Uuid
  /// La clase que esta reemplaza (reprogramar = cancelar la anterior y agendar la nueva en una transacción).
  reprogramada_de_id      String?               @db.Uuid
  motivo_cancelacion      String?
  notas                   String?
  /// Cuándo salió el último recordatorio de esta clase al lead (D3).
  ultimo_recordatorio_en  DateTime?             @db.Timestamptz(6)
  /// Cuándo y quién marcó asistió / no asistió (D4); se actualiza si se corrige.
  asistencia_marcada_en   DateTime?             @db.Timestamptz(6)
  asistencia_marcada_por_usuario_id String?     @db.Uuid
  /// Cuándo y quién marcó que la familia quedó «lista para cerrar» la inscripción (F6).
  listo_para_cerrar_en    DateTime?             @db.Timestamptz(6)
  listo_para_cerrar_por_usuario_id String?      @db.Uuid
  creado_en               DateTime              @default(now()) @db.Timestamptz(6)
  actualizado_en          DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en            DateTime?             @db.Timestamptz(6)

  organizacion     organizacion    @relation(fields: [organizacion_id], references: [id])
  listo_por        usuario?        @relation("clase_listo_por", fields: [listo_para_cerrar_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  lead             lead            @relation(fields: [lead_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  prospecto        prospecto       @relation(fields: [prospecto_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  grupo            grupo           @relation(fields: [grupo_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  agendada_por_usr usuario?        @relation("clase_agendada_por", fields: [agendada_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  asistencia_por   usuario?        @relation("clase_asistencia_por", fields: [asistencia_marcada_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  conversacion     conversacion?   @relation(fields: [conversacion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  reprogramada_de  clase_muestra?  @relation("clase_reprogramada", fields: [reprogramada_de_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  reprogramaciones clase_muestra[] @relation("clase_reprogramada")
  avisos_maestro   aviso_maestro[]
  tareas_asesor    tarea_asesor[]
  registros        registro_clase_muestra[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([grupo_id, fecha_hora])
  @@index([prospecto_id])
  @@index([lead_id])
}

// ── Aviso al maestro (D2, decisión 13) ─────────────────────────────────────────────────

enum tipo_aviso_maestro {
  agendada
  reprogramada
  cancelada
}

enum entrega_aviso_maestro {
  /// El instructor no tiene teléfono: solo la lista de la aplicación (y una tarea para el asesor).
  sin_telefono
  /// Esperando su turno: aún no es horario de envío, o el barrido no ha pasado.
  pendiente
  /// Reclamado por el barrido; el envío está en curso.
  enviando
  enviado
  /// Una regla del MessagingProvider lo frenó (baja, frecuencia, sin plantilla apta…). Queda el motivo.
  bloqueado
  /// Recorrerlo al siguiente horario válido lo dejaba después de la clase (invariante 14).
  descartado
  fallido
}

/// La conversación de WhatsApp de un INSTRUCTOR con la escuela (D2). No es un lead: no entra al embudo ni corre el bot. Existe
/// para que el MessagingProvider le mande avisos con las mismas reglas que a un contacto (ventana de servicio, plantilla, horario,
/// baja, frecuencia) y para saber cuándo respondió (abre su ventana de 24 h). `en_atencion_humana` no aplica a instructores.
model conversacion_instructor {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id            String    @db.Uuid
  instructor_id              String    @db.Uuid
  bandeja_chatwoot_id        String    @db.Uuid
  /// Id visible de la conversación en Chatwoot (display_id, único por cuenta).
  chatwoot_conversacion_id   Int
  /// 24 h desde el último mensaje entrante del instructor (invariante 5).
  ventana_servicio_hasta     DateTime? @db.Timestamptz(6)
  ultimo_mensaje_entrante_en DateTime? @db.Timestamptz(6)
  creado_en                  DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en               DateTime? @db.Timestamptz(6)

  organizacion     organizacion     @relation(fields: [organizacion_id], references: [id])
  instructor       instructor       @relation(fields: [instructor_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  bandeja_chatwoot bandeja_chatwoot @relation(fields: [bandeja_chatwoot_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([instructor_id])
}

/// Lo que se le avisa al maestro de una clase muestra (agendada, reprogramada, cancelada). Es a la vez la LISTA de la
/// aplicación (`leido_en`) y la unidad de envío por WhatsApp (`entrega`). Uno por (clase, tipo): un reintento no duplica.
/// `datos` es una foto de lo que se avisó (alumno, grupo, fecha…) y NUNCA lleva datos de salud.
model aviso_maestro {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id  String                @db.Uuid
  instructor_id    String                @db.Uuid
  clase_muestra_id String                @db.Uuid
  tipo             tipo_aviso_maestro
  datos            Json
  entrega          entrega_aviso_maestro @default(pendiente)
  motivo_entrega   String?
  /// Desde cuándo puede salir por WhatsApp (se recorre al siguiente horario válido).
  programado_para  DateTime              @db.Timestamptz(6)
  enviado_en       DateTime?             @db.Timestamptz(6)
  id_externo       String?
  /// Cuándo lo marcó como visto el maestro en la aplicación.
  leido_en         DateTime?             @db.Timestamptz(6)
  creado_en        DateTime              @default(now()) @db.Timestamptz(6)
  actualizado_en   DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en     DateTime?             @db.Timestamptz(6)

  organizacion  organizacion  @relation(fields: [organizacion_id], references: [id])
  instructor    instructor    @relation(fields: [instructor_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  clase_muestra clase_muestra @relation(fields: [clase_muestra_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([instructor_id, creado_en])
  @@index([entrega, programado_para])
}

// ── Registro de la clase muestra (D5) ──────────────────────────────────────────────────

enum estatus_registro_muestra {
  /// Se está capturando: puede estar a medias.
  borrador
  /// Tiene todo lo necesario para convertir a la familia sin recapturar (alumno, tutores, salud, antecedentes).
  completo
  /// Revisado y bloqueado (exige el reglamento aceptado, D6). Solo un administrador lo reabre.
  cerrado
}

enum sexo_persona {
  femenino
  masculino
  otro
}

enum turno_escolar {
  matutino
  vespertino
  jornada_completa
}

/// Catálogo de motivos por los que buscan la clase (contexto, sección 8). Es un enum de la base; las etiquetas para la
/// persona viven en la interfaz, no en código de negocio.
enum motivo_clase_muestra {
  disciplina
  condicion_fisica
  socializacion
  competencia
  otro
}

enum interes_percibido {
  alto
  medio
  bajo
}

/// Lo que el maestro (o el asesor) captura de una clase muestra, 1:1 con la clase (índice único parcial). Es estructura, no
/// texto: el alumno, sus tutores (`registro_tutor`), sus antecedentes y la observación del maestro viven en columnas y filas
/// para que F2 convierta a la familia en tutor y alumno SIN recapturar nada (invariante 13: nada de `alumno.telefono_mama`).
///
/// LOS DATOS DE SALUD NO ESTÁN AQUÍ: alergias, condiciones médicas, medicamentos, contacto de emergencia y la autorización de
/// atención médica se guardan SOLO cifrados en `ficha_salud` (src/sensibles/), ligados al prospecto. Este modelo solo lleva dos
/// banderas de presencia (`salud_contacto_registrado`, `salud_completa`) que mantiene el módulo sensible, para saber si falta
/// capturarlos sin descifrar nada. `notas_maestro` es texto libre SIN salud.
model registro_clase_muestra {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id  String                   @db.Uuid
  clase_muestra_id String                   @db.Uuid
  prospecto_id     String                   @db.Uuid
  lead_id          String                   @db.Uuid
  estatus          estatus_registro_muestra @default(borrador)

  /// Alumno (nombre completo y fecha de nacimiento del acta, no la edad que dijo el papá).
  alumno_nombre           String?
  alumno_apellidos        String?
  alumno_fecha_nacimiento DateTime?      @db.Date
  alumno_sexo             sexo_persona?
  escuela_nombre          String?
  escuela_turno           turno_escolar?
  talla_uniforme          String?

  /// Antecedentes: si ha practicado antes, dónde y qué nivel traía; el motivo por el que buscan la clase.
  practico_antes       Boolean?
  practico_donde       String?
  practico_nivel       String?
  motivo_clase         motivo_clase_muestra?
  motivo_clase_detalle String?

  /// Observación del maestro (si asistió es `clase_muestra.estatus`: una sola fuente).
  nivel_observado      String?
  /// El grupo que recomienda el maestro; puede ser distinto del que se cotizó.
  grupo_recomendado_id String?            @db.Uuid
  interes_percibido    interes_percibido?
  notas_maestro        String?

  /// Banderas de presencia de la ficha de salud (sin valores). Las mantiene src/sensibles/.
  salud_contacto_registrado Boolean @default(false)
  salud_completa            Boolean @default(false)

  completo_en            DateTime? @db.Timestamptz(6)
  cerrado_en             DateTime? @db.Timestamptz(6)
  cerrado_por_usuario_id String?   @db.Uuid
  creado_por_usuario_id  String    @db.Uuid
  creado_en              DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en           DateTime? @db.Timestamptz(6)

  organizacion      organizacion     @relation(fields: [organizacion_id], references: [id])
  clase_muestra     clase_muestra    @relation(fields: [clase_muestra_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  prospecto         prospecto        @relation(fields: [prospecto_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  lead              lead             @relation(fields: [lead_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  grupo_recomendado grupo?           @relation(fields: [grupo_recomendado_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  creado_por        usuario          @relation("registro_creado_por", fields: [creado_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  cerrado_por       usuario?         @relation("registro_cerrado_por", fields: [cerrado_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  tutores           registro_tutor[]
  aceptaciones_legales aceptacion_legal[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([prospecto_id])
  @@index([lead_id])
  @@index([clase_muestra_id])
}

/// Un adulto del registro: quien lleva al alumno, quien paga, el segundo adulto autorizado para recogerlo… Una fila por persona,
/// con el teléfono normalizado (invariante 7). F2 los convierte en `tutor` (un tutor por teléfono) y en `tutor_alumno`
/// (`es_responsable_pago`, `puede_recoger`) sin volver a preguntar nada. A lo más uno responsable de pago y uno que lo lleva
/// por registro, y un teléfono no se repite (índices únicos parciales).
model registro_tutor {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id     String    @db.Uuid
  registro_id         String    @db.Uuid
  posicion            Int
  nombre              String
  apellidos           String?
  /// Texto libre: «madre», «abuelo», «el mismo alumno» (cuando es adulto)…
  parentesco          String
  /// E.164, de normalizarTelefono().
  telefono            String
  correo              String?
  es_responsable_pago Boolean   @default(false)
  /// Quien lo lleva a la clase.
  lo_lleva            Boolean   @default(false)
  /// Adulto autorizado para recogerlo.
  puede_recoger       Boolean   @default(false)
  creado_en           DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en        DateTime? @db.Timestamptz(6)

  organizacion organizacion           @relation(fields: [organizacion_id], references: [id])
  registro     registro_clase_muestra @relation(fields: [registro_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  aceptaciones_legales aceptacion_legal[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([registro_id])
}

// ── Documentos legales y evidencia de aceptación (D6) ──────────────────────────────────

enum tipo_documento_legal {
  reglamento
  uso_imagen
  /// El aviso de privacidad que acepta quien llena el cuestionario público (E1).
  aviso_privacidad
}

enum resultado_aceptacion {
  aceptada
  /// La familia vio el documento y dijo que no (p. ej. no autoriza el uso de su imagen).
  rechazada
  /// Retiró una aceptación anterior: es una fila NUEVA, la aceptación original no se toca.
  revocada
}

enum canal_aceptacion {
  presencial
  web
  whatsapp
  telefono
}

/// Un documento legal VERSIONADO e INMUTABLE: cambiar el texto es crear la versión siguiente (un disparador impide UPDATE, DELETE y
/// TRUNCATE). `vertical_id` nulo = vale para todas las verticales; uno por vertical manda sobre el general. Vigente = la versión más alta
/// cuyo `vigente_desde` ya llegó. `texto_hash` (SHA-256 del texto) es lo que cada aceptación copia como evidencia de lo que se mostró.
model documento_legal {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id       String               @db.Uuid
  tipo                  tipo_documento_legal
  vertical_id           String?              @db.Uuid
  version               Int
  titulo                String
  texto                 String
  texto_hash            String
  vigente_desde         DateTime             @db.Timestamptz(6)
  creado_por_usuario_id String?              @db.Uuid
  creado_en             DateTime             @default(now()) @db.Timestamptz(6)
  actualizado_en        DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en          DateTime?            @db.Timestamptz(6)

  organizacion organizacion      @relation(fields: [organizacion_id], references: [id])
  vertical     vertical?         @relation(fields: [vertical_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  creado_por   usuario?          @relation("documento_creado_por", fields: [creado_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  aceptaciones aceptacion_legal[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([organizacion_id, tipo, version])
}

/// La evidencia de que alguien aceptó (o rechazó, o revocó) un documento: de SOLO ANEXAR (disparador). Estado vigente = la fila más
/// reciente por (prospecto, tipo) según `secuencia`. Quién aceptó (nombre y parentesco), cuándo, por qué canal, quién lo capturó, el hash de lo
/// que se le mostró, IP y agente si llegó por la web y una evidencia opcional. Revocar la autorización de imagen es una fila nueva.
model aceptacion_legal {
  id                        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id           String               @db.Uuid
  documento_id              String               @db.Uuid
  tipo                      tipo_documento_legal
  version_aceptada          Int
  resultado                 resultado_aceptacion
  lead_id                   String               @db.Uuid
  prospecto_id              String               @db.Uuid
  registro_clase_muestra_id String?              @db.Uuid
  registro_tutor_id         String?              @db.Uuid
  aceptante_nombre          String
  aceptante_parentesco      String?
  canal                     canal_aceptacion
  capturada_por_usuario_id  String?              @db.Uuid
  aceptado_en               DateTime             @db.Timestamptz(6)
  /// SHA-256 del texto que se mostró (copiado del documento).
  texto_hash                String
  evidencia                 Json?
  ip                        String?
  agente_usuario            String?
  /// Orden de registro (aceptado_en puede repetirse).
  secuencia                 BigInt               @default(autoincrement())
  creado_en                 DateTime             @default(now()) @db.Timestamptz(6)
  actualizado_en            DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en              DateTime?            @db.Timestamptz(6)

  organizacion  organizacion             @relation(fields: [organizacion_id], references: [id])
  documento     documento_legal          @relation(fields: [documento_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  lead          lead                     @relation(fields: [lead_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  prospecto     prospecto                @relation(fields: [prospecto_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  registro      registro_clase_muestra?  @relation(fields: [registro_clase_muestra_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  registro_tutor registro_tutor?         @relation(fields: [registro_tutor_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  capturada_por usuario?                 @relation("aceptacion_capturada_por", fields: [capturada_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([prospecto_id, tipo, secuencia])
  @@index([documento_id])
}

// ── Embudo: historial de etapas, motivos de pérdida y reglas de transición (D7) ────────

/// Quién movió al lead de etapa: una persona o el sistema (clase agendada, asistió, el bot…).
enum origen_cambio_etapa {
  usuario
  sistema
}

/// Catálogo de motivos de pérdida, por organización y editable. Los textos viven aquí, no en código (invariante 2).
model motivo_perdida {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String    @db.Uuid
  /// Identificador estable en minúsculas (`precio`, `no_contesto`…). Único entre los vivos de la organización.
  codigo          String
  nombre          String
  orden           Int       @default(0)
  activo          Boolean   @default(true)
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime? @db.Timestamptz(6)

  organizacion organizacion           @relation(fields: [organizacion_id], references: [id])
  leads        lead[]
  historial    lead_etapa_historial[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
}

/// Cada cambio de etapa de un lead, de SOLO ANEXAR (disparador): de dónde a dónde, quién (una persona o el sistema), por qué (`motivo`: el
/// código de la causa; `motivo_perdida_id` si se perdió), la nota y si fue una recuperación. El alta del lead es la primera fila (sin etapa anterior).
model lead_etapa_historial {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id    String              @db.Uuid
  lead_id            String              @db.Uuid
  etapa_anterior_id  String?             @db.Uuid
  etapa_nueva_id     String              @db.Uuid
  origen             origen_cambio_etapa
  usuario_id         String?             @db.Uuid
  motivo             String?
  motivo_perdida_id  String?             @db.Uuid
  nota               String?
  /// De perdido a una etapa activa: el lead se recuperó.
  es_recuperacion    Boolean             @default(false)
  /// V10b: la persona marcó al lead como inscrito A MANO (con la inscripción apagada). Exige origen «usuario» y una nota de al menos 10 caracteres (CHECK).
  a_mano             Boolean             @default(false)
  /// Orden de registro (`creado_en` puede repetirse, p. ej. con un reloj inyectado).
  secuencia          BigInt              @default(autoincrement())
  creado_en          DateTime            @default(now()) @db.Timestamptz(6)
  actualizado_en     DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en       DateTime?           @db.Timestamptz(6)

  organizacion    organizacion    @relation(fields: [organizacion_id], references: [id])
  lead            lead            @relation(fields: [lead_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  etapa_anterior  etapa_pipeline? @relation("historial_etapa_anterior", fields: [etapa_anterior_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  etapa_nueva     etapa_pipeline  @relation("historial_etapa_nueva", fields: [etapa_nueva_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  usuario         usuario?        @relation("historial_usuario", fields: [usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  motivo_perdida  motivo_perdida? @relation(fields: [motivo_perdida_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([lead_id, secuencia])
}

enum regla_transicion {
  /// Vale (es el comportamiento por omisión; sirve para levantar una restricción de otra fila).
  permitida
  solo_administrador
  prohibida
}

/// La matriz de transiciones, configurable y mínima: por defecto se puede pasar de cualquier etapa a cualquier otra salvo las reglas fijas
/// (a una etapa ganada solo con la conversión; de una ganada solo el administrador; de perdida a perdida, no). Una fila endurece o aclara
/// UN par (desde → hacia). Las reglas fijas no se pueden levantar con una fila.
model transicion_etapa {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id  String           @db.Uuid
  desde_etapa_id   String           @db.Uuid
  hacia_etapa_id   String           @db.Uuid
  regla            regla_transicion
  creado_en        DateTime         @default(now()) @db.Timestamptz(6)
  actualizado_en   DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en     DateTime?        @db.Timestamptz(6)

  organizacion organizacion   @relation(fields: [organizacion_id], references: [id])
  desde        etapa_pipeline @relation("transicion_desde", fields: [desde_etapa_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  hacia        etapa_pipeline @relation("transicion_hacia", fields: [hacia_etapa_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
}

// ── Lead frío y promoción por vencer (D8) ──────────────────────────────────────────────

/// El aviso de que una promoción de la cotización vigente de un lead está por vencer: uno por (automatización, lead, promoción), así que el
/// mismo aviso nunca se repite para la misma promoción y el mismo lead (índice único parcial). Es la ENTIDAD de la ejecución del motor
/// (`entidad_tipo = aviso_promocion`): de aquí sale a qué lead, cotización y promoción se refiere.
model aviso_promocion {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id   String    @db.Uuid
  automatizacion_id String    @db.Uuid
  lead_id           String    @db.Uuid
  prospecto_id      String    @db.Uuid
  cotizacion_id     String    @db.Uuid
  promocion_id      String    @db.Uuid
  /// El último día (inclusive, calendario local de la sucursal) en que valía la promoción cuando se creó el aviso.
  vence_el          DateTime  @db.Date
  creado_en         DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en      DateTime? @db.Timestamptz(6)

  organizacion   organizacion   @relation(fields: [organizacion_id], references: [id])
  automatizacion automatizacion @relation(fields: [automatizacion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  lead           lead           @relation(fields: [lead_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  prospecto      prospecto      @relation(fields: [prospecto_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  cotizacion     cotizacion     @relation(fields: [cotizacion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  promocion      promocion      @relation(fields: [promocion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([lead_id])
}

// ── Códigos de rastreo de WhatsApp (E1, E2) ────────────────────────────────────────────

enum tipo_codigo_rastreo {
  /// De una campaña (y quizá una sucursal): se imprime en un QR o se pone en un anuncio; lo usan muchas personas.
  campana
  /// De UN lead que llenó la landing: va en su mensaje prellenado de WhatsApp y se consume al llegar.
  lead
}

/// Un código corto que viaja en el primer mensaje de WhatsApp (o en la URL de la landing) y dice de dónde viene el contacto: campaña, sucursal
/// y, si vino de la landing, qué lead es. 8 caracteres de un alfabeto sin ambiguos (sin I, L, O, 0 ni 1) y con al menos un dígito, único entre
/// los vivos de la organización. `usos` cuenta las veces que se aprovechó; `max_usos` lo limita (1 en los de lead); fuera de su vigencia, apagado o
/// de otra organización, se ignora sin romper nada (E2).
model codigo_rastreo {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String              @db.Uuid
  codigo          String
  tipo            tipo_codigo_rastreo
  campana_id      String?             @db.Uuid
  sucursal_id     String?             @db.Uuid
  vertical_id     String?             @db.Uuid
  lead_id         String?             @db.Uuid
  usos            Int                 @default(0)
  max_usos        Int?
  vigente_desde   DateTime?           @db.Timestamptz(6)
  vigente_hasta   DateTime?           @db.Timestamptz(6)
  activo          Boolean             @default(true)
  creado_en       DateTime            @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime?           @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  campana      campana?     @relation(fields: [campana_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  sucursal     sucursal?    @relation(fields: [sucursal_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  vertical     vertical?    @relation(fields: [vertical_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  lead         lead?        @relation(fields: [lead_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([lead_id])
}

// ── Familia: tutor, alumno y su relación M:N (F1, invariante 13) ───────────────────────────────

enum estatus_alumno {
  activo
  baja
  congelado
}

/// Un adulto responsable de uno o más alumnos. UN tutor por teléfono normalizado dentro de la organización (índice único parcial
/// en la migración): el mismo teléfono es la misma familia. `telefono` siempre de normalizarTelefono() (invariante 7).
model tutor {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id  String    @db.Uuid
  nombre           String
  apellidos        String?
  /// E.164 (CHECK en la migración: sin el «1» de móvil de +521).
  telefono         String
  correo           String?
  direccion        String?
  como_nos_conocio String?
  /// Sucursal donde se dio de alta la familia (define quién la ve: asesor y recepción solo las de sus sucursales).
  sucursal_id      String?   @db.Uuid
  creado_en        DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en     DateTime? @db.Timestamptz(6)

  organizacion organizacion   @relation(fields: [organizacion_id], references: [id])
  sucursal     sucursal?      @relation(fields: [sucursal_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  alumnos      tutor_alumno[]
  leads        lead[]
  cargos       cargo[]
  pagos        pago[]
  ventas       venta[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
}

/// Quien toma las clases. SIN campos de salud (alergias, condiciones, medicamentos, contacto de emergencia): viven cifrados en
/// `ficha_salud` con sujeto `alumno` (src/sensibles/). `autoriza_uso_imagen` no es una columna: se deriva de la última aceptación
/// de la autorización de imagen (D6) de su prospecto de origen. NUNCA un campo tipo `telefono_mama` (invariante 13): los adultos
/// son filas de `tutor` ligadas por `tutor_alumno`.
model alumno {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id      String                @db.Uuid
  nombre               String
  apellidos            String
  /// Del acta (no la edad que dijo el papá).
  fecha_nacimiento     DateTime              @db.Date
  sexo                 sexo_persona?
  estatus              estatus_alumno        @default(activo)
  /// Sucursal donde se dio de alta (ver `tutor.sucursal_id`).
  sucursal_id          String?               @db.Uuid
  escuela_nombre       String?
  escuela_turno        turno_escolar?
  talla_uniforme       String?
  /// Antecedentes que capturó el maestro en la clase muestra (no son salud).
  practico_antes       Boolean?
  practico_donde       String?
  practico_nivel       String?
  motivo_clase         motivo_clase_muestra?
  motivo_clase_detalle String?
  creado_en            DateTime              @default(now()) @db.Timestamptz(6)
  actualizado_en       DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en         DateTime?             @db.Timestamptz(6)

  organizacion organizacion   @relation(fields: [organizacion_id], references: [id])
  sucursal     sucursal?      @relation(fields: [sucursal_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  tutores      tutor_alumno[]
  prospectos   prospecto[]
  inscripciones inscripcion[]
  cargos       cargo[]
  ventas       venta[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  progresiones alumno_progresion[]
  eventos_alumno evento_alumno[]
}

/// Puente M:N: un alumno puede tener mamá, papá y abuela; un tutor, varios hijos en varias verticales. Una fila viva por
/// (tutor, alumno) y a lo más un responsable de pago por alumno (índices únicos parciales en la migración).
model tutor_alumno {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id     String    @db.Uuid
  tutor_id            String    @db.Uuid
  alumno_id           String    @db.Uuid
  /// Texto libre: «madre», «abuela»…
  parentesco          String
  es_responsable_pago Boolean   @default(false)
  /// El adulto al que se llama en una urgencia. Es la bandera `es_contacto_emergencia` del modelo de datos; se llama distinto porque
  /// ese nombre es una raíz de dato de salud para `check:sensibles` (el contacto de emergencia con sus datos vive CIFRADO en `ficha_salud`).
  es_contacto_urgencia Boolean  @default(false)
  puede_recoger       Boolean   @default(false)
  /// Quien lo lleva a la clase.
  lo_lleva            Boolean   @default(false)
  creado_en           DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en        DateTime? @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  tutor        tutor        @relation(fields: [tutor_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  alumno       alumno       @relation(fields: [alumno_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([tutor_id])
  @@index([alumno_id])
}

// ── Inscripción (F3) ───────────────────────────────────────────────────────────────────────────

enum estatus_inscripcion {
  activa
  congelada
  baja
}

/// El puente entre el alumno y la oferta. Guarda el origen (`lead_id`, `prospecto_id`) para el costo por alumno inscrito por campaña, y
/// CONGELA lo que se le prometió: el precio de lista que regía el día de la inscripción y lo que valieron sus promociones inmediatas.
/// Si después sube el precio, esta inscripción conserva el suyo. Una inscripción ACTIVA por (alumno, grupo) y el cupo del grupo se cuenta
/// con las activas (índices parciales en la migración). Dinero `Decimal(12,2)`; en código, siempre `src/lib/dinero.ts`.
model inscripcion {
  id                             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id                String              @db.Uuid
  alumno_id                      String              @db.Uuid
  grupo_id                       String              @db.Uuid
  programa_id                    String              @db.Uuid
  lead_id                        String?             @db.Uuid
  prospecto_id                   String?             @db.Uuid
  cotizacion_id                  String?             @db.Uuid
  /// La promoción principal aplicada (la de mayor prioridad); todas están en `promocion_aplicacion`.
  promocion_id                   String?             @db.Uuid
  /// El día (calendario local de la sucursal) en que se inscribió: el de los precios.
  fecha_inscripcion              DateTime            @db.Date
  fecha_inicio                   DateTime            @db.Date
  fecha_baja                     DateTime?           @db.Date
  estatus                        estatus_inscripcion @default(activa)
  /// Precio de lista que regía el día de la inscripción (`precioVigente`), antes de promociones.
  precio_inscripcion_aplicado    Decimal             @db.Decimal(12, 2)
  precio_mensualidad_aplicado    Decimal             @db.Decimal(12, 2)
  /// Lo que descuentan las promociones INMEDIATAS (las diferidas viven en `promocion_aplicacion`, pendientes).
  descuento_inscripcion_aplicado Decimal             @default(0) @db.Decimal(12, 2)
  descuento_mensualidad_aplicado Decimal             @default(0) @db.Decimal(12, 2)
  meses_gratis_aplicados         Int                 @default(0)
  meses_pagados_por_adelantado   Int                 @default(0)
  /// Por qué se dio de baja (catálogo editable por organización, F5). Solo con `estatus = baja`.
  motivo_baja_id                 String?             @db.Uuid
  /// Desde cuándo está congelada (F5). Solo con `estatus = congelada`.
  congelada_desde                DateTime?           @db.Date
  /// Día del mes en que corta el pago (1 a 31). En un mes más corto vale su último día (`src/inscripciones/corte.ts`).
  dia_corte_pago                 Int
  creado_por_usuario_id          String?             @db.Uuid
  creado_en                      DateTime            @default(now()) @db.Timestamptz(6)
  actualizado_en                 DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en                   DateTime?           @db.Timestamptz(6)

  organizacion  organizacion          @relation(fields: [organizacion_id], references: [id])
  alumno        alumno                @relation(fields: [alumno_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  grupo         grupo                 @relation(fields: [grupo_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  programa      programa              @relation(fields: [programa_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  lead          lead?                 @relation(fields: [lead_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  prospecto     prospecto?            @relation(fields: [prospecto_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  cotizacion    cotizacion?           @relation(fields: [cotizacion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  promocion     promocion?            @relation(fields: [promocion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  creado_por    usuario?              @relation("inscripcion_creada_por", fields: [creado_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  motivo_baja   motivo_baja?          @relation(fields: [motivo_baja_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  aplicaciones  promocion_aplicacion[]
  movimientos   inscripcion_movimiento[]

  tareas_asesor tarea_asesor[]
  asistencias   asistencia[]
  cargos        cargo[]
  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([alumno_id])
  @@index([grupo_id])
  @@index([lead_id])
}

// ── Cambio de grupo, congelar y baja (F5) ──────────────────────────────────────────────────────

/// Catálogo editable de motivos de baja de una inscripción, por organización (como `motivo_perdida`). El código nunca decide nada: solo se reporta.
model motivo_baja {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String    @db.Uuid
  /// Identificador estable en minúsculas. Único entre los vivos de la organización.
  codigo          String
  nombre          String
  orden           Int       @default(0)
  activo          Boolean   @default(true)
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime? @db.Timestamptz(6)

  organizacion organizacion              @relation(fields: [organizacion_id], references: [id])
  inscripciones inscripcion[]
  movimientos  inscripcion_movimiento[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
}

enum tipo_movimiento_inscripcion {
  cambio_grupo
  congelacion
  reactivacion
  baja
}

/// Lo que le pasó a una inscripción después de nacer: de SOLO ANEXAR (disparador). Corregir un movimiento es otro movimiento. De aquí sale el
/// «historial de cambios de grupo» del expediente.
model inscripcion_movimiento {
  id                String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id   String                      @db.Uuid
  inscripcion_id    String                      @db.Uuid
  tipo              tipo_movimiento_inscripcion
  grupo_anterior_id String?                     @db.Uuid
  grupo_nuevo_id    String?                     @db.Uuid
  motivo_baja_id    String?                     @db.Uuid
  /// El día (calendario local de la sucursal) en que surte efecto.
  fecha             DateTime                    @db.Date
  usuario_id        String?                     @db.Uuid
  /// Orden de registro (`creado_en` puede repetirse).
  secuencia         BigInt                      @default(autoincrement())
  creado_en         DateTime                    @default(now()) @db.Timestamptz(6)
  actualizado_en    DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en      DateTime?                   @db.Timestamptz(6)

  organizacion    organizacion @relation(fields: [organizacion_id], references: [id])
  inscripcion     inscripcion  @relation(fields: [inscripcion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  grupo_anterior  grupo?       @relation("movimiento_grupo_anterior", fields: [grupo_anterior_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  grupo_nuevo     grupo?       @relation("movimiento_grupo_nuevo", fields: [grupo_nuevo_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  motivo_baja     motivo_baja? @relation(fields: [motivo_baja_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  usuario         usuario?     @relation("movimiento_usuario", fields: [usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([inscripcion_id, secuencia])
}

// ── WH: un webhook nunca responde 500 por un dato inesperado ─────────────────────────────────────────────

enum origen_evento_inesperado {
  chatwoot
  twilio_entrante
  twilio_estado
  landing
  /// El barrido de reenvío del borde de Twilio (un evento que se abandona o que no se deja reenviar por sus datos).
  barrido_twilio
}

enum causa_evento_inesperado {
  json_invalido
  forma_inesperada
  sin_identificador
  dato_invalido
  texto_con_nul
  restriccion_base
  registro_inexistente
  bandeja_sin_aprovisionar
  reenvio_abandonado
  error_interno
}

/// Constancia de un evento público (webhook o landing) que llegó con datos inesperados. Se guarda UNA vez por evento del proveedor (`origen`, `clave`);
/// un reintento solo suma `intentos`. NUNCA lleva el contenido del evento: `forma` es su estructura (tipos y largos, sin valores), `detalle` el error saneado y
/// truncado. `organizacion_id` es nulo cuando el evento no se pudo atar a ninguna organización (solo se escribe y se lee por `src/datos/sistema.ts`).
model evento_inesperado {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String?                  @db.Uuid
  origen          origen_evento_inesperado
  /// Identificador del evento del proveedor (id de mensaje, MessageSid + estado…) o, si no hay, el SHA-256 del cuerpo.
  clave           String
  causa           causa_evento_inesperado
  detalle         String
  forma           Json                     @default("{}")
  intentos        Int                      @default(1)
  lead_id         String?                  @db.Uuid
  conversacion_id String?                  @db.Uuid
  tarea_id        String?                  @db.Uuid
  creado_en       DateTime                 @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime?                @db.Timestamptz(6)

  organizacion organizacion?  @relation(fields: [organizacion_id], references: [id], onDelete: Restrict)
  lead         lead?          @relation(fields: [lead_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  conversacion conversacion?  @relation(fields: [conversacion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  tarea        tarea_asesor?  @relation(fields: [tarea_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
}

// ── Pase de lista (G1) ──────────────────────────────────────────────────────────────────────────

enum estatus_asistencia {
  presente
  falta
  /// Falta avisada o con motivo. No cuenta como falta ni como asistencia en el porcentaje, y no suma ni rompe la racha de faltas (G2).
  justificada
}

enum metodo_asistencia {
  manual
  qr
}

/// Una fila por (inscripción, fecha): idempotente. La fecha es el día de calendario LOCAL de la sucursal en que sesionó el grupo; solo hay filas de las
/// sesiones con pase tomado, así la racha de faltas (G2) cuenta sesiones y no días del calendario. Corregir una fila deja su registro en `registro_cambio`.
model asistencia {
  id                        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id           String             @db.Uuid
  inscripcion_id            String             @db.Uuid
  /// El grupo en el que se tomó el pase (el de la inscripción ese día; la inscripción puede cambiar de grupo después).
  grupo_id                  String             @db.Uuid
  fecha                     DateTime           @db.Date
  estatus                   estatus_asistencia
  metodo                    metodo_asistencia  @default(manual)
  registrado_por_usuario_id String?            @db.Uuid
  creado_en                 DateTime           @default(now()) @db.Timestamptz(6)
  actualizado_en            DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en              DateTime?          @db.Timestamptz(6)

  organizacion  organizacion @relation(fields: [organizacion_id], references: [id])
  inscripcion   inscripcion  @relation(fields: [inscripcion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  grupo         grupo        @relation(fields: [grupo_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  registrado_por usuario?    @relation("asistencia_registrada_por", fields: [registrado_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([inscripcion_id, fecha])
  @@index([grupo_id, fecha])
}

// ── Progresión genérica (G3) ───────────────────────────────────────────────────────────────────

/// Un peldaño de la progresión de una vertical (nivel, grado…): una FILA, nunca una columna ni un término del código (invariante 2). El nombre con el que
/// la escuela le dice a esto vive en `vertical.etiqueta_progresion`. `orden` ordena los peldaños de la vertical (único entre los vivos).
model nivel_progresion {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id  String    @db.Uuid
  vertical_id      String    @db.Uuid
  nombre           String
  orden            Int
  /// `#RRGGBB` o nulo (CHECK en la migración).
  color_hex        String?
  /// Mínimos para ser elegible al SIGUIENTE peldaño: `clases_minimas` son asistencias `presente` desde que se obtuvo el peldaño anterior (G4). Las horas se capturan
  /// pero hoy no se exigen (no hay duración por sesión en la asistencia).
  horas_minimas    Int       @default(0)
  clases_minimas   Int       @default(0)
  requisitos_texto String?
  creado_en        DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en     DateTime? @db.Timestamptz(6)

  organizacion  organizacion         @relation(fields: [organizacion_id], references: [id])
  vertical      vertical             @relation(fields: [vertical_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  progresiones  alumno_progresion[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([vertical_id])
  otorgados_en_eventos evento_alumno[]
}

/// Un peldaño que un alumno obtuvo. El nivel ACTUAL de una vertical es el más reciente (`fecha_obtenido` y, a igualdad, `creado_en`). Una fila por (alumno, nivel).
model alumno_progresion {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id           String    @db.Uuid
  alumno_id                 String    @db.Uuid
  nivel_id                  String    @db.Uuid
  fecha_obtenido            DateTime  @db.Date
  /// El evento en el que se otorgó (G4); nulo si lo registró una persona fuera de un evento. Un peldaño por (evento, alumno).
  evento_id                 String?   @db.Uuid
  instructor_id             String?   @db.Uuid
  /// Texto libre del maestro. NO se audita ni sale del expediente: puede mencionar salud (decisión 12).
  observaciones             String?
  registrado_por_usuario_id String?   @db.Uuid
  creado_en                 DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en              DateTime? @db.Timestamptz(6)

  organizacion   organizacion      @relation(fields: [organizacion_id], references: [id])
  alumno         alumno            @relation(fields: [alumno_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  nivel          nivel_progresion  @relation(fields: [nivel_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  evento         evento?           @relation(fields: [evento_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  instructor     instructor?       @relation(fields: [instructor_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  registrado_por usuario?          @relation("progresion_registrada_por", fields: [registrado_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([alumno_id])
  @@index([nivel_id])
}

// ── Eventos y elegibilidad (G4) ────────────────────────────────────────────────────────────────

enum estatus_evento_alumno {
  convocado
  confirmado
  pagado
  asistio
}

enum resultado_evento {
  aprobado
  no_aprobado
}

/// Un evento de una vertical en una sucursal (un examen, una exhibición…): el nombre con el que la escuela le dice vive en `vertical.etiqueta_evento`
/// y el `tipo` es un texto corto que elige ella. El CUPO se protege en la base: un disparador toma la fila del evento y cuenta; ver la migración.
model evento {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id     String    @db.Uuid
  vertical_id         String    @db.Uuid
  sucursal_id         String    @db.Uuid
  tipo                String
  nombre              String
  /// El día del evento (calendario local de la sucursal).
  fecha               DateTime  @db.Date
  /// Lo que cuesta participar. Dinero exacto (nunca flotante). El maestro no lo ve.
  cuota               Decimal   @default(0) @db.Decimal(12, 2)
  /// Lugares: convocados, confirmados, pagados y asistentes ocupan uno. Entre 1 y lo que quepa; no se puede bajar por debajo de los ocupados.
  cupo                Int
  requiere_vestuario  Boolean   @default(false)
  /// ¿Aprobar en este evento sube de peldaño? Si sí, solo se convoca a quien es elegible por clases mínimas (G4). Una exhibición, por ejemplo, no.
  otorga_progresion   Boolean   @default(true)
  creado_por_usuario_id String? @db.Uuid
  creado_en           DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en        DateTime? @db.Timestamptz(6)

  organizacion  organizacion        @relation(fields: [organizacion_id], references: [id])
  vertical      vertical            @relation(fields: [vertical_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  sucursal      sucursal            @relation(fields: [sucursal_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  creado_por    usuario?            @relation("evento_creado_por", fields: [creado_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  participantes evento_alumno[]
  progresiones  alumno_progresion[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([vertical_id, fecha])
  @@index([sucursal_id])
}

/// Un alumno en un evento. Una fila viva por (evento, alumno). El estatus solo avanza (convocado → confirmado → pagado → asistio). `resultado` solo con `asistio`;
/// si aprobó un evento que otorga progresión, `nivel_otorgado_id` es el peldaño que se le dio (y su `alumno_progresion` apunta a este evento).
model evento_alumno {
  id                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id           String                @db.Uuid
  evento_id                 String                @db.Uuid
  alumno_id                 String                @db.Uuid
  estatus                   estatus_evento_alumno @default(convocado)
  resultado                 resultado_evento?
  nivel_otorgado_id         String?               @db.Uuid
  registrado_por_usuario_id String?               @db.Uuid
  creado_en                 DateTime              @default(now()) @db.Timestamptz(6)
  actualizado_en            DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en              DateTime?             @db.Timestamptz(6)

  organizacion   organizacion      @relation(fields: [organizacion_id], references: [id])
  evento         evento            @relation(fields: [evento_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  alumno         alumno            @relation(fields: [alumno_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  nivel_otorgado nivel_progresion? @relation(fields: [nivel_otorgado_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  registrado_por usuario?          @relation("evento_alumno_registrado_por", fields: [registrado_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([evento_id])
  @@index([alumno_id])
}

// ── Finanzas (etapa H): cargos ─────────────────────────────────────────────────────────────────────

enum concepto_cargo {
  inscripcion
  mensualidad
  evento
  producto
}

enum estatus_cargo {
  pendiente
  pagado
  /// Se materializa con el barrido de cobranza; el estatus «vencido» efectivo también se deriva de `fecha_vencimiento` (src/finanzas/cargos.ts).
  vencido
  cancelado
}

/// Lo que una familia debe. UN responsable de pago (`tutor_id`) por cargo. Dinero `Decimal(12,2)`; en código, SIEMPRE `src/lib/dinero.ts` (centavos `bigint`).
/// `monto_final = monto − descuento` y no cambian después de nacer (disparador). `monto_pagado` lo mantiene la BASE (disparadores de `pago_aplicacion`,
/// H2) y nunca pasa de `monto_final`: así dos pagos simultáneos al mismo cargo no pueden sobrepagarlo ni dejar saldos incoherentes. El estatus es coherente con el
/// saldo por CHECK (pagado ⇔ `monto_pagado = monto_final`; cancelado solo sin pagos). Una mensualidad por (inscripción, periodo) y un cargo de inscripción
/// por inscripción (índices únicos parciales en la migración): la generación mensual repetida o en paralelo nunca duplica. Cancelar = estatus, nunca borrar.
model cargo {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id          String         @db.Uuid
  /// El responsable de pago al generarse el cargo.
  tutor_id                 String         @db.Uuid
  alumno_id                String         @db.Uuid
  /// Nulo en un cargo suelto (un evento, un producto).
  inscripcion_id           String?        @db.Uuid
  /// El cargo de una venta de producto (H5): uno por venta. Anular la venta cancela este cargo.
  venta_id                 String?        @db.Uuid
  /// Sucursal que cobra (define la zona horaria del vencimiento y quién lo ve).
  sucursal_id              String         @db.Uuid
  concepto                 concepto_cargo
  /// `AAAA-MM`. Obligatorio en una mensualidad.
  periodo                  String?
  descripcion              String?
  monto                    Decimal        @db.Decimal(12, 2)
  descuento                Decimal        @default(0) @db.Decimal(12, 2)
  monto_final              Decimal        @db.Decimal(12, 2)
  /// Σ de las aplicaciones vivas de pagos (la mantiene la base). Saldo = monto_final − monto_pagado.
  monto_pagado             Decimal        @default(0) @db.Decimal(12, 2)
  fecha_vencimiento        DateTime       @db.Date
  estatus                  estatus_cargo  @default(pendiente)
  creado_por_usuario_id    String?        @db.Uuid
  cancelado_en             DateTime?      @db.Timestamptz(6)
  cancelado_por_usuario_id String?        @db.Uuid
  motivo_cancelacion       String?
  creado_en                DateTime       @default(now()) @db.Timestamptz(6)
  actualizado_en           DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en             DateTime?      @db.Timestamptz(6)

  organizacion  organizacion  @relation(fields: [organizacion_id], references: [id])
  tutor         tutor         @relation(fields: [tutor_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  alumno        alumno        @relation(fields: [alumno_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  inscripcion   inscripcion?  @relation(fields: [inscripcion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  sucursal      sucursal      @relation(fields: [sucursal_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  venta         venta?        @relation(fields: [venta_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  creado_por    usuario?      @relation("cargo_creado_por", fields: [creado_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  cancelado_por usuario?      @relation("cargo_cancelado_por", fields: [cancelado_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  aplicaciones  pago_aplicacion[]
  tareas_asesor tarea_asesor[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([tutor_id, estatus])
  @@index([alumno_id])
  @@index([inscripcion_id])
  @@index([estatus, fecha_vencimiento])
}

// ── Finanzas (etapa H): pagos ──────────────────────────────────────────────────────────────────────

enum metodo_pago {
  efectivo
  tarjeta
  transferencia
}

enum estatus_pago {
  aplicado
  cancelado
}

enum estatus_aplicacion_pago {
  aplicada
  revertida
}

/// Dinero que entró de una familia (REGISTRO MANUAL: decisión 10, sin pasarela). Un pago es de un tutor y se reparte entre varios cargos de varios hijos
/// (`pago_aplicacion`). Nunca se borra ni se edita: cancelar = estatus `cancelado` (sus aplicaciones pasan a `revertida`). `monto_aplicado` lo mantiene la BASE
/// (disparadores de `pago_aplicacion`) y un pago aplicado cubre EXACTAMENTE su monto (disparador diferido): no existe saldo a favor. `clave_idempotencia` es la clave
/// del cliente: un reintento del mismo POST no registra dos pagos (único por organización).
model pago {
  id                        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id           String       @db.Uuid
  tutor_id                  String       @db.Uuid
  monto                     Decimal      @db.Decimal(12, 2)
  monto_aplicado            Decimal      @default(0) @db.Decimal(12, 2)
  metodo                    metodo_pago
  referencia                String?
  /// El día (calendario local) en que se recibió.
  fecha                     DateTime     @db.Date
  estatus                   estatus_pago @default(aplicado)
  clave_idempotencia        String?
  registrado_por_usuario_id String?      @db.Uuid
  cancelado_en              DateTime?    @db.Timestamptz(6)
  cancelado_por_usuario_id  String?      @db.Uuid
  motivo_cancelacion        String?
  creado_en                 DateTime     @default(now()) @db.Timestamptz(6)
  actualizado_en            DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en              DateTime?    @db.Timestamptz(6)

  organizacion   organizacion       @relation(fields: [organizacion_id], references: [id])
  tutor          tutor              @relation(fields: [tutor_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  registrado_por usuario?           @relation("pago_registrado_por", fields: [registrado_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  cancelado_por  usuario?           @relation("pago_cancelado_por", fields: [cancelado_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  aplicaciones   pago_aplicacion[]
  beneficios_liberados promocion_aplicacion[] @relation("aplicacion_liberada_por")

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([tutor_id, fecha])
}

/// Cuánto de un pago cubrió un cargo. De SOLO ANEXAR salvo el paso `aplicada → revertida` (cancelar el pago). Los disparadores suman/restan en
/// `cargo.monto_pagado` y `pago.monto_aplicado` con UN UPDATE atómico y los CHECK de la base impiden sobrepagar. El pago y el cargo son del MISMO tutor.
model pago_aplicacion {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String                  @db.Uuid
  pago_id         String                  @db.Uuid
  cargo_id        String                  @db.Uuid
  monto_aplicado  Decimal                 @db.Decimal(12, 2)
  estatus         estatus_aplicacion_pago @default(aplicada)
  revertida_en    DateTime?               @db.Timestamptz(6)
  creado_en       DateTime                @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime?               @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  pago         pago         @relation(fields: [pago_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  cargo        cargo        @relation(fields: [cargo_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  // EH-09: un pago cubre un cargo UNA vez. El índice lo crea la migración de pagos; sin declararlo aquí, `prisma migrate dev` generaba un DROP INDEX.
  @@unique([pago_id, cargo_id], map: "pago_aplicacion_pago_cargo_key")
  @@index([organizacion_id])
  @@index([pago_id])
  @@index([cargo_id])
}

// ── Finanzas (etapa H): productos y ventas ─────────────────────────────────────────────────────────

/// Catálogo de productos de la escuela (uniformes, equipo, zapatos…), por vertical. El `stock` NUNCA baja de cero (CHECK en la migración) y solo lo mueven los disparadores de
/// `venta` (vender descuenta, anular devuelve) y el ajuste atómico de inventario: dos ventas por la última pieza, gana una.
model producto {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String    @db.Uuid
  vertical_id     String    @db.Uuid
  nombre          String
  talla           String?
  precio          Decimal   @db.Decimal(12, 2)
  stock           Int       @default(0)
  activo          Boolean   @default(true)
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime? @db.Timestamptz(6)

  organizacion organizacion          @relation(fields: [organizacion_id], references: [id])
  vertical     vertical              @relation(fields: [vertical_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  ventas       venta[]
  beneficios   promocion_beneficio[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([vertical_id])
}

enum estatus_venta {
  registrada
  anulada
}

/// Una venta de producto a una familia. El precio unitario se CONGELA al vender. Una venta normal genera su `cargo` (concepto `producto`, uno por venta); una venta PROMOCIONAL
/// (`es_promocional`, la entrega de un beneficio diferido) es de precio 0, no genera cargo y apunta a su `promocion_aplicacion` (una sola venta por aplicación). Insertar la
/// venta descuenta el stock y anularla lo devuelve (disparadores): no hay venta sin movimiento de inventario.
model venta {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id          String        @db.Uuid
  tutor_id                 String        @db.Uuid
  alumno_id                String        @db.Uuid
  producto_id              String        @db.Uuid
  sucursal_id              String        @db.Uuid
  cantidad                 Int
  precio_unitario          Decimal       @db.Decimal(12, 2)
  es_promocional           Boolean       @default(false)
  promocion_aplicacion_id  String?       @db.Uuid
  /// El día (calendario local de la sucursal) de la venta.
  fecha                    DateTime      @db.Date
  estatus                  estatus_venta @default(registrada)
  /// K9 (UI-03): un reintento del mismo envío no duplica la venta (ni su cargo ni el descuento de existencia). Único parcial (organización, clave) entre las vivas, en la migración.
  clave_idempotencia       String?       @db.VarChar(120)
  registrada_por_usuario_id String?      @db.Uuid
  anulada_en               DateTime?     @db.Timestamptz(6)
  anulada_por_usuario_id   String?       @db.Uuid
  motivo_anulacion         String?
  creado_en                DateTime      @default(now()) @db.Timestamptz(6)
  actualizado_en           DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en             DateTime?     @db.Timestamptz(6)

  organizacion         organizacion          @relation(fields: [organizacion_id], references: [id])
  tutor                tutor                 @relation(fields: [tutor_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  alumno               alumno                @relation(fields: [alumno_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  producto             producto              @relation(fields: [producto_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  sucursal             sucursal              @relation(fields: [sucursal_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  promocion_aplicacion promocion_aplicacion? @relation(fields: [promocion_aplicacion_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  registrada_por       usuario?              @relation("venta_registrada_por", fields: [registrada_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  anulada_por          usuario?              @relation("venta_anulada_por", fields: [anulada_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  cargos               cargo[]

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([tutor_id])
  @@index([alumno_id])
  @@index([producto_id])
}

// ── Reportes (etapa I): gasto de las campañas ──────────────────────────────────────────────────────

/// Lo que la escuela gastó en una campaña (I2): CAPTURADO A MANO por el administrador (no hay integración con las plataformas de anuncios). Dinero `Decimal(12,2)`, siempre positivo; se borra
/// con baja lógica. Con el gasto, el reporte de costo por alumno inscrito divide entre los leads, las clases muestra y las inscripciones activas que nacieron de la campaña.
model gasto_campana {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id       String    @db.Uuid
  campana_id            String    @db.Uuid
  fecha                 DateTime  @db.Date
  monto                 Decimal   @db.Decimal(12, 2)
  nota                  String?
  /// K9 (EK-I04): un reintento del mismo envío no duplica el gasto. Único parcial (organización, campaña, clave) entre los vivos, en la migración.
  clave_idempotencia    String?   @db.VarChar(120)
  creado_por_usuario_id String?   @db.Uuid
  creado_en             DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en          DateTime? @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])
  campana      campana      @relation(fields: [campana_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)
  creado_por   usuario?     @relation("gasto_creado_por", fields: [creado_por_usuario_id, organizacion_id], references: [id, organizacion_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
  @@index([campana_id, fecha])
}

/// V5: un mensaje del bot que la escuela personalizó. Solo guarda lo que CAMBIÓ (sin fila, el bot usa el texto por omisión del código). `clave` es del catálogo de
/// src/captacion/textos.ts; `texto` lleva huecos como {nombre} que el servidor valida. A lo más una fila viva por (organización, clave): índice único parcial en la migración.
model texto_bot {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizacion_id String    @db.Uuid
  clave           String    @db.VarChar(60)
  texto           String    @db.VarChar(600)
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  eliminado_en    DateTime? @db.Timestamptz(6)

  organizacion organizacion @relation(fields: [organizacion_id], references: [id])

  @@unique([id, organizacion_id])
  @@index([organizacion_id])
}
