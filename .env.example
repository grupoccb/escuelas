# Copia a .env para correr el backend y los tests desde el host.
DATABASE_URL=postgresql://inscripciones:inscripciones@localhost:5432/inscripciones
# Base aparte para `npm run test:int` (se crea sola si no existe).
DATABASE_URL_PRUEBAS=postgresql://inscripciones:inscripciones@localhost:5432/inscripciones_pruebas
PORT=3000
# Las credenciales de Chatwoot de la demo están en config/demo-local.env.

# Borde de Twilio (A7). Apagado mientras falten TWILIO_AUTH_TOKEN y PUBLIC_BASE_URL: las rutas
# /webhooks/twilio/* rechazan todo con 403. Nunca pongas aquí un token real en un repositorio.
# TWILIO_AUTH_TOKEN=
# URL pública del backend tal como la ve Twilio, sin ruta ni barra final: se firma contra ella.
# PUBLIC_BASE_URL=https://api.ejemplo.com
# A dónde se reenvía lo que llega (por defecto ${CHATWOOT_URL}/twilio/callback y /twilio/delivery_status).
# TWILIO_REENVIO_ENTRANTES_URL=
# TWILIO_REENVIO_ESTADOS_URL=
# Opción apagada: normalizar `From` (invariante 7) antes de reenviar. Cambia el cuerpo.
# TWILIO_NORMALIZAR_FROM_AL_REENVIAR=true

# API de la aplicación (B1-B3).
# Origen(es) desde los que un navegador puede hacer peticiones que cambian algo (CSRF), separados por
# comas. Sin definir: solo el propio host de la petición. Si no, cae en PUBLIC_BASE_URL.
# ORIGEN_PUBLICO=https://app.ejemplo.com
# La cookie de sesión lleva Secure con NODE_ENV=production; fuérzala con true/false (p. ej. demo en http).
# COOKIE_SEGURA=false
# Minutos de inactividad que cierran una sesión (por defecto 120; la expiración absoluta es de 12 h).
# SESION_INACTIVIDAD_MIN=120

# Datos de salud de menores (B4): clave de cifrado, 32 bytes en base64 (`openssl rand -base64 32`).
# Obligatoria con NODE_ENV=production; sin ella fuera de producción se usa una clave de desarrollo NO secreta.
# CLAVE_DATOS_SENSIBLES=

# Directorio de agentes de Chatwoot (B5): token de un ADMINISTRADOR de la cuenta (el del Agent Bot no puede
# listar agentes). Con CHATWOOT_URL permite vincular usuarios con sus agentes. En la demo viene en config/demo-local.env.
# CHATWOOT_ADMIN_TOKEN=

# Protección de rutas públicas (B6): límites por IP, por minuto. Valores por defecto entre paréntesis.
# LIMITE_LOGIN_POR_MINUTO=10
# LIMITE_API_POR_MINUTO=600
# LIMITE_LANDING_POR_MINUTO=30
# LIMITE_WEBHOOK_FALLOS_POR_MINUTO=30
# LIMITE_WEBHOOK_POR_MINUTO=6000
# LIMITE_MAX_CLAVES=50000
# IP real detrás de un balanceador: número de saltos de proxy de confianza (1) o lista de redes. Sin definir: ninguno.
# TRUST_PROXY=1
