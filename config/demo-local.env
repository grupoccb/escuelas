# Demo local (SPEC 0.5). Valores SOLO de desarrollo, fijos a propósito para que la demo se
# reconstruya igual después de `docker compose down -v`. Nunca se usan fuera de esta máquina.
# ⚠ SON PÚBLICOS (están en el repositorio). Con NODE_ENV=production el backend se NIEGA a arrancar si encuentra
# valores como estos (src/seguridad/entorno.ts) salvo que la variable ENTORNO_DEMO=si lo declare como demo.
# `check:secretos` los tiene en una lista de excepciones por ruta exacta; ningún otro archivo puede llevar secretos.
# Lo leen docker compose (env_file) y los scripts del host (simular-contacto).

# Backend → Chatwoot (red interna de compose)
CHATWOOT_URL=http://chatwoot:3000
# Host → Chatwoot (simulador y enlaces)
CHATWOOT_URL_HOST=http://localhost:3001

CHATWOOT_CUENTA=Demo local
CHATWOOT_ADMIN_NOMBRE=Asesor demo
CHATWOOT_ADMIN_EMAIL=asesor@demo.test
CHATWOOT_ADMIN_PASSWORD=Demo-local-2026!
CHATWOOT_ADMIN_TOKEN=demo-local-token-admin-0001

CHATWOOT_BOT_NOMBRE=Bot de captación
CHATWOOT_BOT_TOKEN=demo-local-token-bot-0001
CHATWOOT_WEBHOOK_URL=http://backend:3000/webhooks/chatwoot
CHATWOOT_WEBHOOK_SECRETO=demo-local-secreto-webhook-0001
