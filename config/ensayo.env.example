# Ensayo con WhatsApp real (V9). Copia este archivo a `.env` (que git ignora) y llena SOLO lo que dice «LLENA».
#   cp config/ensayo.env.example .env      (si ya tienes un .env, copia estas líneas al final)
# Los secretos (el token) viven ÚNICAMENTE en `.env`. Nunca los pongas en un archivo que se sube al repositorio.
# Pasos completos: docs/ENSAYO-WHATSAPP-REAL.md

# Marca de que esta máquina hace el ensayo. Un despliegue real NO la lleva (el backend se niega a arrancar con ella).
ENSAYO_LOCAL=si

# Chatwoot sin el bloqueo de los dominios de Twilio (solo para el ensayo). No cambies este valor.
ENSAYO_TWILIO_BLOQUEO_PREFIJO=apagado-

# LLENA. De la consola de Twilio (https://console.twilio.com → Account Info).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# El número del sandbox de WhatsApp, con el signo +. Casi siempre es este; compáralo con el que muestra tu consola
# (Messaging → Try it out → Send a WhatsApp message).
TWILIO_WHATSAPP_NUMERO=+14155238886

# LLENA con `npm run ensayo:preparar -- --url https://…` (lo escribe por ti). Es la dirección https que te da el túnel; cambia en cada arranque.
# ORIGEN_PUBLICO=

# Opcional: a qué canal de la escuela se le pone el número del sandbox (nombre público). Sin esto, al primero.
# ENSAYO_CANAL=
