{
  "name": "inscripciones",
  "version": "0.0.0",
  "private": true,
  "description": "Sistema de captación y gestión para escuelas multi-disciplina (Grupo CCB)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "prisma generate && npm --prefix web ci",
    "dev": "NODE_ENV=development node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "check:generico": "node scripts/check-generico.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "validar": "npm run lint && npm run typecheck && npm run check:generico && npm run check:capas && npm run check:sensibles && npm run check:dinero && npm run check:secretos && npm test && npm run web:validar",
    "test:int": "node scripts/test-int.ts",
    "test:navegador": "node scripts/test-navegador.ts",
    "web:instalar": "npm --prefix web ci",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:validar": "npm --prefix web run validar",
    "check:capas": "node scripts/check-capas.ts",
    "check:sensibles": "node scripts/check-sensibles.ts",
    "check:dinero": "node scripts/check-dinero.ts",
    "demo:contacto": "node --env-file=config/demo-local.env scripts/simular-contacto.ts",
    "reporte:leads": "node --env-file-if-exists=.env scripts/reporte-leads.ts",
    "demo:datos": "NODE_ENV=development node --env-file-if-exists=.env scripts/demo-datos.ts",
    "cuadratura": "node --env-file-if-exists=.env scripts/cuadratura.ts",
    "reporte:clases-muestra": "node --env-file-if-exists=.env scripts/reporte-clases-muestra.ts",
    "check:secretos": "node scripts/check-secretos.ts",
    "demo:guiada": "node scripts/demo-guiada.ts",
    "infra:validar": "node scripts/infra-validar.ts",
    "respaldo": "node scripts/respaldo.ts",
    "restaurar": "node scripts/restaurar.ts",
    "catalogo:plantillas": "node scripts/catalogo-plantillas.ts",
    "catalogo:importar": "node --env-file-if-exists=.env scripts/catalogo-importar.ts",
    "guias:capturas": "GUIAS_ESCRIBIR=1 node scripts/test-navegador.ts -- e2e/v8-guias.spec.ts e2e/v8-impresion-guias.spec.ts",
    "guias:validar": "node --test scripts/guias-validar.test.ts",
    "ensayo:preparar": "node --env-file=config/demo-local.env --env-file-if-exists=.env scripts/ensayo-preparar.ts",
    "ensayo:entrante": "node --env-file=config/demo-local.env --env-file-if-exists=.env scripts/ensayo-entrante.ts",
    "ensayo:diagnostico": "node --env-file=config/demo-local.env --env-file-if-exists=.env scripts/ensayo-diagnostico.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "5.2.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "jsqr": "1.4.0",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
