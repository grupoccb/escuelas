{
  "name": "inscripciones",
  "version": "0.0.0",
  "private": true,
  "description": "Sistema de captación y gestión para escuelas multi-disciplina (Grupo CCB)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "check:generico": "node scripts/check-generico.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "validar": "npm run lint && npm run typecheck && npm run check:generico && npm run check:capas && npm test",
    "test:int": "node scripts/test-int.ts",
    "check:capas": "node scripts/check-capas.ts",
    "demo:contacto": "node --env-file=config/demo-local.env scripts/simular-contacto.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "5.2.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
